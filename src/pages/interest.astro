---
import Layout from "@/layouts/PageLayout.astro";
import PageHeader from "@/components/PageHeader.astro";
---

<Layout wide>
    <div class="flex w-full flex-col gap-8">
        <PageHeader level="h1">Want to Join?</PageHeader>

        <p class="max-w-3xl text-lg leading-relaxed">
            If you'd like to join the team, please submit this inquiry form.
            We'll get back to you with information about meetings.<br />
            There is no selection process—if you come to the meetings, you're in!
        </p>

        <div class="w-full h-300 overflow-hidden rounded-base border-none shadow-none">
            <iframe
                class="block w-full h-full border-none outline-none shadow-none"
                src="https://tally.so/embed/KYbz6k?alignLeft=1&hideTitle=1&transparentBackground=1&dynamicHeight=1"
                title="Team V.A.N. interest form"
                loading="lazy"
                scrolling="no"
            ></iframe>
        </div>
    </div>
</Layout>
