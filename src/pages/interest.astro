---
import Layout from "@/layouts/PageLayout.astro";
import H from "@/components/H.astro";
import Iframe from "@/components/Iframe.astro";
import Loader from "@/components/Loader.astro";
import Section from "@/components/Section.astro";
---

<Layout
    title="Join Team V.A.N."
    description="Join Team V.A.N. in Palm Bay, Florida. No prior experience is required for students interested in robotics, engineering, programming, business, or marketing."
>
    <H>Want to Join?</H>

    <Section aria-labelledby="form-heading">
        <H id="form-heading" level="h2">
            Student Interest Form
        </H>
        <p class="mb-4">
            Fill out the form below to let us know you're interested! We will
            reach out with details on our meeting schedule, build space location
            in Palm Bay, and how to get started. No prior experience is
            required.
        </p>

        <Iframe
            containerClass="w-full h-[800px] overflow-hidden rounded-base border-none shadow-none"
            class="w-full h-full border-none outline-none shadow-none"
            src="https://tally.so/embed/KYbz6k?alignLeft=1&hideTitle=1&transparentBackground=1&dynamicHeight=1"
            title="Team V.A.N. interest form"
            loaderClass="bg-transparent items-start mt-12"
            loading="eager"
            scrolling="no"
        >
            <Loader slot="loader" class="border-white/30 border-t-white" />
        </Iframe>

        <p class="mt-6">
            Have questions before joining? Email us at{" "}
            <a
                href="mailto:contact@teamvan.org"
                class="text-blue-300 underline underline-offset-4"
            >
                contact@teamvan.org
            </a>
            .
        </p>
    </Section>
</Layout>
