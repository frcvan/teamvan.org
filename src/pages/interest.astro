---
import Layout from "@/layouts/PageLayout.astro";
import PageHeader from "@/components/PageHeader.astro";
import Iframe from "@/components/Iframe.astro";
import Loader from "@/components/Loader.astro";
---

<Layout>
    <div class="flex w-full flex-col gap-8">
        <PageHeader>Want to Join?</PageHeader>

        <p class="max-w-3xl text-lg leading-relaxed">
            If you'd like to join the team, please submit this inquiry form.
            We'll get back to you with information about meetings.
        </p>
        <p class="max-w-3xl text-lg leading-relaxed">
            For other inquiries, feel free to write an email!
        </p>

        <Iframe
            containerClass="w-full h-300 overflow-hidden rounded-base border-none shadow-none"
            class="w-full h-full border-none outline-none shadow-none"
            src="https://tally.so/embed/KYbz6k?alignLeft=1&hideTitle=1&transparentBackground=1&dynamicHeight=1"
            title="Team V.A.N. interest form"
            loaderClass="bg-transparent items-start mt-12"
            loading="eager"
            scrolling="no"
        >
            <Loader slot="loader" class="border-white/30 border-t-white" />
        </Iframe>
    </div>
</Layout>
