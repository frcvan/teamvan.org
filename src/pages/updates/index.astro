---
import Layout from "@/layouts/PageLayout.astro";
import { formatUpdateDate, updates } from "@/data/updates";
---

<Layout
    title="Updates"
    description="News and notes from Team V.A.N., a rookie FIRST Robotics Competition team in Palm Bay, Florida."
>
    <header>
        <p class="text-[0.65rem] font-bold tracking-[0.18em] text-link uppercase">
            Updates
        </p>
        <h1 class="mt-2">Team Updates</h1>
        <p class="mt-2 max-w-2xl">
            Short posts about meetings, events, and what the team is working on.
        </p>
    </header>
    {updates.length > 0 ? (
        <ul class="grid list-none gap-4 p-0">
            {updates.map((post) => (
                <li>
                    <a
                        href={`/updates/${post.slug}/`}
                        class="block border-4 border-rule bg-secondary-background px-4 py-3 text-main no-underline shadow-[6px_6px_0_var(--rule)] transition-transform hover:-translate-y-0.5"
                    >
                        <time
                            datetime={post.date}
                            class="text-[0.65rem] font-bold tracking-[0.18em] text-link uppercase"
                        >
                            {formatUpdateDate(post.date)}
                        </time>
                        <p class="mt-2 font-heading text-2xl leading-tight font-extrabold uppercase">
                            {post.title}
                        </p>
                        <p class="mt-2 text-sm">{post.summary}</p>
                    </a>
                </li>
            ))}
        </ul>
    ) : (
        <p>No updates yet. Check back after our next meeting.</p>
    )}
</Layout>
