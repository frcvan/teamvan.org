---
import Layout from "@/layouts/PageLayout.astro";
import components from "@/components/mdx";
import { formatUpdateDate, updates } from "@/data/updates";

export function getStaticPaths() {
    return updates.map((update) => ({
        params: { slug: update.slug },
        props: { update },
    }));
}

const { update } = Astro.props;
const { Content, title, summary, date } = update;
---

<Layout title={title} description={summary}>
    <article>
        <header>
            <p class="text-[0.65rem] font-bold tracking-[0.18em] text-link uppercase">
                Update · {formatUpdateDate(date)}
            </p>
            <h1 class="mt-2">{title}</h1>
            <p class="mt-2 max-w-2xl">{summary}</p>
        </header>
        <div class="mt-6 space-y-6">
            <Content components={components} />
        </div>
    </article>
    <p class="mt-8 text-sm">
        <a href="/updates/" class="link-bar font-bold text-link">
            All updates
        </a>
    </p>
</Layout>
