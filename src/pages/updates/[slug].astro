---
import Layout from "@/layouts/PageLayout.astro";
import Button from "@/components/Button.astro";
import components from "@/components/mdx";
import { formatUpdateDate, updates } from "@/data/updates";

export function getStaticPaths() {
    return updates.map((update) => ({
        params: { slug: update.slug },
        props: { update },
    }));
}

const { update } = Astro.props;
const { Content, title, summary, date } = update;
---

<Layout title={title} description={summary}>
    <article>
        <header class="border-b-4 border-rule pb-6">
            <div class="flex flex-wrap items-center gap-3">
                <p class="inline-block border-2 border-ink bg-gold px-2 py-1 text-[0.65rem] font-bold tracking-[0.18em] text-ink uppercase shadow-[3px_3px_0_var(--ink)]">
                    Update
                </p>
                <time
                    datetime={date}
                    class="text-[0.65rem] font-bold tracking-[0.18em] text-link uppercase"
                >
                    {formatUpdateDate(date)}
                </time>
            </div>
            <h1 class="mt-3">{title}</h1>
            <p class="mt-3 max-w-2xl text-lg">{summary}</p>
        </header>
        <div class="mt-6 space-y-6">
            <Content components={components} />
        </div>
    </article>
    <div class="mt-8">
        <Button href="/updates/" variant="secondary" size="sm">
            <span
                aria-hidden="true"
                class="grid size-6 place-items-center border-2 border-rule bg-gold text-[0.7rem] leading-none font-bold text-ink"
            >
                ←
            </span>
            All updates
        </Button>
    </div>
</Layout>
