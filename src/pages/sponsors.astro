---
import copy from "@/content/site/sponsors.json";
import H from "@/components/H.astro";
import Layout from "@/layouts/PageLayout.astro";
import Button from "@/components/Button.astro";
import Section from "@/components/Section.astro";
import { Icon } from "astro-icon/components";
---

<Layout title={copy.text001} description={copy.text002}>
    <H><span class="editor-text">{copy.text003}</span></H>

    <Section aria-labelledby="sponsorship-heading">
        <H id="sponsorship-heading" level="h2">
            <span class="editor-text">{copy.text004}</span>
        </H>
        <p><span class="editor-text">{copy.text005}</span></p>
    </Section>

    <Section aria-labelledby="rookie-partner-heading">
        <H id="rookie-partner-heading" level="h2">
            <span class="editor-text">{copy.text006}</span>
        </H>
        <p><span class="editor-text">{copy.text007}</span></p>
        <p><span class="editor-text">{copy.text008}</span></p>
        <p>
            <strong class="underline underline-offset-4"><span class="editor-text">{copy.text009}</span></strong>{" "}
            <span class="editor-text">{copy.text010}</span>{" "}
            <a
                href="https://themindforgeguild.org"
                class="text-blue-300 underline underline-offset-4"
            >
                <span class="editor-text">{copy.text011}</span>
            </a>
            <span class="editor-text">{copy.text012}</span>
        </p>
    </Section>

    <Section aria-labelledby="impact-heading">
        <H id="impact-heading" level="h2">
            <span class="editor-text">{copy.text013}</span>
        </H>
        <p><span class="editor-text">{copy.text014}</span></p>
        <ul class="list-disc pl-6 space-y-2">
            <li>
                <strong><span class="editor-text">{copy.text015}</span></strong>
                <span class="editor-text">{copy.text016}</span>
            </li>
            <li>
                <strong><span class="editor-text">{copy.text017}</span></strong> <span class="editor-text">{copy.text018}</span>
            </li>
            <li>
                <strong><span class="editor-text">{copy.text019}</span></strong> <span class="editor-text">{copy.text020}</span>
            </li>
            <li>
                <span class="editor-text">{copy.text021}</span> <strong><span class="editor-text">{copy.text022}</span></strong> <span class="editor-text">{copy.text023}</span>
            </li>
        </ul>
        <p><span class="editor-text">{copy.text024}</span></p>
    </Section>

    <Section aria-labelledby="community-heading">
        <H id="community-heading" level="h2">
            <span class="editor-text">{copy.text025}</span>
        </H>
        <p><span class="editor-text">{copy.text026}</span></p>
        <p><span class="editor-text">{copy.text027}</span></p>
    </Section>

    <Section aria-labelledby="how-we-operate-heading">
        <H id="how-we-operate-heading" level="h2">
            <span class="editor-text">{copy.text028}</span>
        </H>
        <p>
            <span class="editor-text">{copy.text029}</span>{" "}
            <a
                href="/about/"
                class="text-blue-300 underline underline-offset-4"
            >
                <span class="editor-text">{copy.text030}</span>
            </a>{" "}
            <span class="editor-text">{copy.text031}</span>
        </p>
    </Section>

    <Section aria-labelledby="ways-to-support-heading">
        <H id="ways-to-support-heading" level="h2">
            <span class="editor-text">{copy.text032}</span>
        </H>
        <ul class="list-disc pl-6 space-y-2">
            <li>
                <strong><span class="editor-text">{copy.text033}</span></strong> <span class="editor-text">{copy.text034}</span>
            </li>
            <li>
                <strong><span class="editor-text">{copy.text035}</span></strong> <span class="editor-text">{copy.text036}</span>
            </li>
            <li>
                <strong><span class="editor-text">{copy.text037}</span></strong> <span class="editor-text">{copy.text038}</span>
            </li>
        </ul>
    </Section>

    <Section aria-labelledby="donations-heading">
        <H id="donations-heading" level="h2">
            <span class="editor-text">{copy.text039}</span>
        </H>
        <p><span class="editor-text">{copy.text040}</span></p>
        <div class="flex flex-wrap gap-4 mt-4">
            <Button
                target="_blank"
                href="/investment-packet.pdf"
                variant="secondary"
            >
                <Icon name="tabler:download" size={32} />
                <span class="editor-text">{copy.text041}</span>
            </Button>
            <Button
                href="mailto:contact@teamvan.org?subject=Sponsorship%20Inquiry%20-%20Team%20V.A.N."
                variant="secondary"
            >
                <Icon name="tabler:mail" size={32} />
                <span class="editor-text">{copy.text042}</span>
            </Button>
        </div>
    </Section>
</Layout>
