---
import copy from "@/content/site/sponsors.json";
import H from "@/components/H.astro";
import Layout from "@/layouts/PageLayout.astro";
import Button from "@/components/Button.astro";
import Section from "@/components/Section.astro";
import { Icon } from "astro-icon/components";
---

<Layout title={copy.text001} description={copy.text002}>
    <H>{copy.text003}</H>

    <Section aria-labelledby="sponsorship-heading">
        <H id="sponsorship-heading" level="h2">
            {copy.text004}
        </H>
        <p>{copy.text005}</p>
    </Section>

    <Section aria-labelledby="rookie-partner-heading">
        <H id="rookie-partner-heading" level="h2">
            {copy.text006}
        </H>
        <p>{copy.text007}</p>
        <p>{copy.text008}</p>
        <p>
            <strong class="underline underline-offset-4">{copy.text009}</strong>{" "}
            {copy.text010}{" "}
            <a
                href="https://themindforgeguild.org"
                class="text-blue-300 underline underline-offset-4"
            >
                {copy.text011}
            </a>
            {copy.text012}
        </p>
    </Section>

    <Section aria-labelledby="impact-heading">
        <H id="impact-heading" level="h2">
            {copy.text013}
        </H>
        <p>{copy.text014}</p>
        <ul class="list-disc pl-6 space-y-2">
            <li>
                <strong>{copy.text015}</strong>
                {copy.text016}
            </li>
            <li>
                <strong>{copy.text017}</strong> {copy.text018}
            </li>
            <li>
                <strong>{copy.text019}</strong> {copy.text020}
            </li>
            <li>
                {copy.text021} <strong>{copy.text022}</strong> {copy.text023}
            </li>
        </ul>
        <p>{copy.text024}</p>
    </Section>

    <Section aria-labelledby="community-heading">
        <H id="community-heading" level="h2">
            {copy.text025}
        </H>
        <p>{copy.text026}</p>
        <p>{copy.text027}</p>
    </Section>

    <Section aria-labelledby="how-we-operate-heading">
        <H id="how-we-operate-heading" level="h2">
            {copy.text028}
        </H>
        <p>
            {copy.text029}{" "}
            <a
                href="/about/"
                class="text-blue-300 underline underline-offset-4"
            >
                {copy.text030}
            </a>{" "}
            {copy.text031}
        </p>
    </Section>

    <Section aria-labelledby="ways-to-support-heading">
        <H id="ways-to-support-heading" level="h2">
            {copy.text032}
        </H>
        <ul class="list-disc pl-6 space-y-2">
            <li>
                <strong>{copy.text033}</strong> {copy.text034}
            </li>
            <li>
                <strong>{copy.text035}</strong> {copy.text036}
            </li>
            <li>
                <strong>{copy.text037}</strong> {copy.text038}
            </li>
        </ul>
    </Section>

    <Section aria-labelledby="donations-heading">
        <H id="donations-heading" level="h2">
            {copy.text039}
        </H>
        <p>{copy.text040}</p>
        <div class="flex flex-wrap gap-4 mt-4">
            <Button
                target="_blank"
                href="/investment-packet.pdf"
                variant="secondary"
            >
                <Icon name="tabler:download" size={32} />
                {copy.text041}
            </Button>
            <Button
                href="mailto:contact@teamvan.org?subject=Sponsorship%20Inquiry%20-%20Team%20V.A.N."
                variant="secondary"
            >
                <Icon name="tabler:mail" size={32} />
                {copy.text042}
            </Button>
        </div>
    </Section>
</Layout>
