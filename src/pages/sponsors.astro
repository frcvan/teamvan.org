---
import PageHeader from "@/components/PageHeader.astro";
import Layout from "@/layouts/PageLayout.astro";
---

<Layout>
    <PageHeader>For Sponsors</PageHeader>
    <section class="mt-12 space-y-4" aria-labelledby="donations-heading">
        <h2 id="donations-heading" class="text-2xl font-semibold tracking-tight sm:text-3xl">
            Donate To Our Team
        </h2>
        <p>
            Interested in making a donation or contributing materials? Contact us
            to discuss how you can help.
        </p>
        <div class="flex flex-wrap gap-4">
            <a
                href="/sponsor-packet.pdf"
                download="Sponsorship Form.pdf"
                class="inline-block rounded-base border border-silver text-white px-5 py-3 font-semibold underline decoration-silver underline-offset-4 hover:bg-white/10 focus-visible:outline-2 focus-visible:outline-offset-4"
            >
                Sponsorship Form
            </a>
            <a
                href="mailto:contact@teamvan.org?subject=Donation%20to%20Team%20V.A.N."
                class="inline-block rounded-base border border-silver text-white px-5 py-3 font-semibold underline decoration-silver underline-offset-4 hover:bg-white/10 focus-visible:outline-2 focus-visible:outline-offset-4"
            >
                Contact Us For Donations
            </a>
        </div>
    </section>
</Layout>
