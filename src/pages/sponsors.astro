---
import H from "@/components/H.astro";
import Layout from "@/layouts/PageLayout.astro";
import Button from "@/components/Button.astro";
import Section from "@/components/Section.astro";
---

<Layout title="For Sponsors">
    <H>For Sponsors</H>
    <Section aria-labelledby="donations-heading">
        <H id="donations-heading" level="h2">
            Donate To Our Team
        </H>
        <p>
            Interested in making a donation or contributing materials? Contact
            us to discuss how you can help.
        </p>
        <div class="flex flex-wrap gap-4">
            <Button
                target="_blank"
                href="/sponsor-packet.pdf"
                variant="secondary"
            >
                Sponsorship Form
            </Button>
            <Button
                href="mailto:contact@teamvan.org?subject=Donation%20to%20Team%20V.A.N."
                variant="secondary"
            >
                Contact Us For Donations
            </Button>
        </div>
    </Section>
</Layout>
