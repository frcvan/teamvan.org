---
import H from "@/components/H.astro";
import Layout from "@/layouts/PageLayout.astro";
import Section from "@/components/Section.astro";
---

<Layout>
    <H class="mb-4">Team V.A.N.</H>

    <p>Student-led FIRST Robotics Competition (FRC) Team.</p>

    <Section>
        <H level="h2">What we do</H>
        <p>
            A student-led rookie FIRST Robotics team based in Brevard, Florida.
        </p>
        <p>
            You'll learn how to design, build, and program industrial-size
            robots while developing business, marketing, and presentation
            skills.
        </p>
    </Section>
</Layout>
