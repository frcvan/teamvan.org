---
import PageHeader from "@/components/PageHeader.astro";
import Layout from "@/layouts/PageLayout.astro";
---

<Layout>
    <div class="mb-4">
        <PageHeader>Team V.A.N.</PageHeader>
    </div>

    <p>Student-led FIRST Robotics Competition (FRC) Team.</p>

    <section class="mt-12 space-y-4">
        <h2 class="text-2xl font-semibold tracking-tight sm:text-3xl">
            What we do
        </h2>
        <p>
            A student-led rookie FIRST Robotics team based in Brevard, Florida.
        </p>
        <p>
            You'll learn how to design, build, and program industrial-size
            robots while developing business, marketing, and presentation
            skills.
        </p>
    </section>
</Layout>
