---
import copy from "@/content/site/index.json";
import Alert from "@/components/Alert.astro";
import H from "@/components/H.astro";
import Layout from "@/layouts/PageLayout.astro";
import Section from "@/components/Section.astro";
---

<Layout title={copy.text001} description={copy.text002}>
    <H class="mb-2">{copy.text003}</H>

    <p class="mb-6 text-white font-semibold">
        {copy.text004} <i>{copy.text005}</i> {copy.text006}
    </p>

    <p>{copy.text007}</p>

    <Alert title={copy.text008} class="mt-6">
        <p>{copy.text009}</p>
        <p>{copy.text010}</p>
        <p>
            {copy.text011}{" "}
            <a
                href="https://maps.app.goo.gl/EZpkUnE5RZaprrsCA"
                class="text-blue-300 underline underline-offset-4"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Open map to Mind Forge at 2475 Palm Bay Road, Suite 210, in a new tab"
            >
                {copy.text012}
            </a>
        </p>
    </Alert>

    <Section>
        <p>{copy.text013}</p>
        <p>{copy.text014}</p>
        <p>{copy.text015}</p>
    </Section>

    <Section>
        <H level="h2">{copy.text016}</H>
        <p>
            {copy.text017}{" "}
            <a
                href="/about/"
                class="text-blue-300 underline underline-offset-4"
            >
                {copy.text018}
            </a>{" "}
            {copy.text019}
        </p>
        <p>{copy.text020}</p>

        <H level="h2">{copy.text021}</H>
        <p>{copy.text022}</p>

        <H level="h2">
            <a
                href="/interest/"
                class="text-inherit underline decoration-silver underline-offset-4"
            >
                {copy.text023}
            </a>
        </H>
        <p>
            {copy.text024}{" "}
            <a
                href="/interest/"
                class="text-blue-300 underline underline-offset-4"
            >
                {copy.text025}
            </a>
            .
        </p>
    </Section>
</Layout>
