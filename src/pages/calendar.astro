---
import Alert from "@/components/Alert.astro";
import Layout from "@/layouts/PageLayout.astro";
import H from "@/components/H.astro";
import Iframe from "@/components/Iframe.astro";
import Loader from "@/components/Loader.astro";
import Section from "@/components/Section.astro";
---

<Layout
    title="Team Calendar"
    description="See upcoming Team V.A.N. meetings, events, and activities in the Palm Bay and Space Coast area."
>
    <H level="h1">Team Calendar</H>
    <Alert title="Student kickoff" class="mt-6">
        <p>Date: November 2nd</p>
        <p>Time: 6:00 PM to 8:00 PM</p>
        <p>
            Location: Mind Forge Guild —{" "}
            <a
                href="https://maps.app.goo.gl/EZpkUnE5RZaprrsCA"
                class="text-blue-300 underline underline-offset-4"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Open map to Mind Forge at 2475 Palm Bay Road, Suite 210, in a new tab"
            >
                2475 Palm Bay Rd, Suite 210
            </a>
        </p>
        <p>
            The team calendar is shared publicly.{" "}
            <a
                href="https://calendar.google.com/calendar/u/0?cid=ZnJjMTIxNDhAZ21haWwuY29t"
                class="text-blue-300 underline underline-offset-4"
            >
                <strong>click here</strong>
            </a>{" "}
            to add it to your own.
        </p>
    </Alert>
    <Section>
        <Iframe
            containerClass="w-full overflow-hidden rounded-base border border-black/15 bg-white shadow-sm"
            class="h-150 w-full border-0 max-[600px]:h-[70vh]"
            src="https://calendar.google.com/calendar/embed?wkst=2&ctz=America%2FNew_York&showPrint=0&title=FRC%2012148%20Calendar&src=ZnJjMTIxNDhAZ21haWwuY29t&color=%23652633"
            title="Team V.A.N. calendar"
            loading="eager"
            scrolling="no"
        >
            <Loader slot="loader" />
        </Iframe>
    </Section>
</Layout>
