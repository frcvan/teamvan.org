---
import copy from "@/content/site/calendar.json";
import { Icon } from "astro-icon/components";
import Alert from "@/components/Alert.astro";
import Button from "@/components/Button.astro";
import Layout from "@/layouts/PageLayout.astro";
import H from "@/components/H.astro";
import Iframe from "@/components/Iframe.astro";
import Loader from "@/components/Loader.astro";
import Section from "@/components/Section.astro";
---

<Layout title={copy.text001} description={copy.text002}>
    <H level="h1"><span class="editor-text">{copy.text003}</span></H>
    <Alert title={copy.text004} class="mt-6">
        <p><span class="editor-text">{copy.text005}</span></p>
        <p><span class="editor-text">{copy.text006}</span></p>
        <p>
            <span class="editor-text">{copy.text007}</span>{" "}
            <a
                href="https://maps.app.goo.gl/EZpkUnE5RZaprrsCA"
                class="text-blue-300 underline underline-offset-4"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Open map to Mind Forge at 2475 Palm Bay Road, Suite 210, in a new tab"
            >
                <span class="editor-text">{copy.text008}</span>
            </a>
        </p>
    </Alert>
    <Section>
        <Iframe
            containerClass="w-full overflow-hidden rounded-base border border-black/15 bg-white shadow-sm"
            class="h-150 w-full border-0 max-[600px]:h-[70vh]"
            src="https://calendar.google.com/calendar/embed?wkst=2&ctz=America%2FNew_York&showPrint=0&title=FRC%2012148%20Calendar&src=ZnJjMTIxNDhAZ21haWwuY29t&color=%23652633"
            title={copy.text009}
            loading="eager"
            scrolling="no"
        >
            <Loader slot="loader" />
        </Iframe>
        <div class="flex flex-wrap gap-4 mt-4">
            <Button
                href="https://calendar.google.com/calendar/u/0?cid=ZnJjMTIxNDhAZ21haWwuY29t"
                variant="secondary"
            >
                <Icon name="tabler:plus" size={32} />
                <span class="editor-text">{copy.text010}</span>
            </Button>
        </div>
    </Section>
</Layout>
