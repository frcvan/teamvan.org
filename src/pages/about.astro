---
import H from "@/components/H.astro";
import Layout from "@/layouts/PageLayout.astro";
import Section from "@/components/Section.astro";
import List from "@/components/List.astro";
import Timeline from "@/components/Timeline.astro";
import StatGrid from "@/components/StatGrid.astro";
---

<Layout
    title="What Is FIRST"
    description="Learn what FIRST Robotics Competition is, how its season works, and how Team V.A.N. competes."
>
    <Section aria-labelledby="what-is-frc-heading" class="mt-0!">
        <H id="what-is-frc-heading">What is FIRST Robotics?</H>
        <p>
            The FIRST Robotics Competition (FRC) is an international high school
            engineering program. Every January, teams get a Kit of Parts and a
            new game, then have about six weeks to design, build, program, and
            test a competition robot before shipping it off to events. From
            February through April, teams compete in head-to-head matches at
            regional and district events around the world, working to qualify
            for the FIRST Championship.
        </p>
        <p>
            FRC runs on two values as much as it runs on robots:{" "}
            <strong>Gracious Professionalism</strong>, treating competitors with
            the same respect as teammates, and <strong>Coopertition</strong>,
            the idea that teams can help each other and still compete hard.
            Teams also earn judged awards for engineering quality, community
            impact, and mentorship, not just match wins.
        </p>
        <StatGrid
            stats={[
                { value: "3,700+", label: "teams worldwide" },
                { value: "33", label: "countries & regions" },
                { value: "90,000+", label: "students competing" },
                { value: "~600", label: "teams at FIRST Championship" },
            ]}
        />
    </Section>

    <Section aria-labelledby="timeline-heading">
        <H id="timeline-heading" level="h2">
            Our season at a glance
        </H>
        <p>
            Team V.A.N. runs on the standard FIRST Robotics Competition
            calendar, with a team kickoff of our own on November 2 to get new
            members ready before the season starts. Exact dates shift from year
            to year; this is the shape of a typical season.
        </p>
        <Timeline
            phases={[
                {
                    period: "November 2",
                    title: "Team Kickoff",
                    description:
                        "New members meet, review safety basics, and get introduced to the team before the official FIRST season begins.",
                },
                {
                    period: "Early January",
                    title: "Kickoff",
                    description:
                        "FIRST reveals the new game. The team studies the rules, brainstorms strategy, and starts prototyping that same weekend.",
                },
                {
                    period: "January – February",
                    title: "Build season",
                    description:
                        "About six weeks to design, build, and program the competition robot, ending in late February, when the robot is bagged and no further changes are allowed until competition. The goal is to have it finished and competition-ready in time for our first event, the Orlando Regional, in March.",
                },
                {
                    period: "February – April",
                    title: "Competition events",
                    description:
                        "The team travels to regional events to compete, iterate on the robot between events, and work toward qualifying for the FIRST Championship.",
                },
                {
                    period: "April",
                    title: "FIRST Championship",
                    description:
                        "If the team qualifies, the season culminates at the FIRST Championship in Houston, Texas, alongside roughly 600 teams from around the world.",
                },
            ]}
        />
    </Section>

    <Section aria-labelledby="facilities-heading">
        <H id="facilities-heading" level="h2">
            Where we work
        </H>
        <p>
            We meet and build in more than one place so the team is not
            dependent on a single partnership.
        </p>
        <List>
            <li>
                <strong>Mind Forge Guild</strong> is a local makerspace and our
                primary prototyping location, with woodworking and prototyping
                facilities. The makerspace has offered free access and weekend
                space to set up and practice on a field.
            </li>
            <li>
                <strong>Eastern Florida State College</strong> has pledged
                permanent space on campus for weekday meetings, planning, and
                team activities. We have access to their machine shop, 3D
                printer farm, tools, and storage. Metalworking faculty can
                assist with machining custom metal components, while we supply
                the raw materials.
            </li>
        </List>
    </Section>
</Layout>
