---
import copy from "@/content/site/about.json";
import H from "@/components/H.astro";
import Layout from "@/layouts/PageLayout.astro";
import Section from "@/components/Section.astro";
import Timeline from "@/components/Timeline.astro";
import StatGrid from "@/components/StatGrid.astro";
---

<Layout title={copy.text001} description={copy.text002}>
    <Section aria-labelledby="what-is-frc-heading" class="mt-0!">
        <H id="what-is-frc-heading"><span class="editor-text">{copy.text003}</span></H>
        <p><span class="editor-text">{copy.text004}</span></p>
        <p>
            <span class="editor-text">{copy.text005}</span> <strong><span class="editor-text">{copy.text006}</span></strong>
            <span class="editor-text">{copy.text007}</span> <strong><span class="editor-text">{copy.text008}</span></strong>
            <span class="editor-text">{copy.text009}</span>
        </p>
        <StatGrid
            stats={[
                { value: "3,700+", label: "teams worldwide" },
                { value: "33", label: "countries & regions" },
                { value: "90,000+", label: "students competing" },
                { value: "~600", label: "teams at FIRST Championship" },
            ]}
        />
    </Section>

    <Section aria-labelledby="timeline-heading">
        <H id="timeline-heading" level="h2">
            <span class="editor-text">{copy.text010}</span>
        </H>
        <p><span class="editor-text">{copy.text011}</span></p>
        <Timeline
            phases={[
                {
                    period: "November 15",
                    title: "Team Kickoff",
                    description:
                        "New members meet, review safety basics, and get introduced to the team before the official FIRST season begins.",
                },
                {
                    period: "Early January",
                    title: "Kickoff",
                    description:
                        "FIRST reveals the new game. The team studies the rules, brainstorms strategy, and starts prototyping that same weekend.",
                },
                {
                    period: "January – February",
                    title: "Build Season",
                    description:
                        "About six weeks to design, build, and program the competition robot, ending in late February, when the robot is bagged and no further changes are allowed until competition. The goal is to have it finished and competition-ready in time for our first event, the Orlando Regional, in March.",
                },
                {
                    period: "February – April",
                    title: "Competition Events",
                    description:
                        "The team travels to regional events to compete, iterate on the robot between events, and work toward qualifying for the FIRST Championship.",
                },
                {
                    period: "April",
                    title: "FIRST Championship",
                    description:
                        "If the team qualifies, the season culminates at the FIRST Championship in Houston, Texas, alongside roughly 600 teams from around the world.",
                },
            ]}
        />
    </Section>
</Layout>
