---
import H from "@/components/H.astro";
import Layout from "@/layouts/PageLayout.astro";
import Section from "@/components/Section.astro";
import List from "@/components/List.astro";
---

<Layout title="Outreach">
    <H>Outreach</H>
    <Section aria-labelledby="fll-competitions-heading">
        <H id="fll-competitions-heading" level="h2">
            FLL Competitions
        </H>
        <List>
            <li>
                <p><strong>October 17, 2026</strong> — FLL Challenge Scrimmage (Pinellas)</p>
                <p>Azalea Middle School</p>
                <a
                    href="https://www.google.com/maps/search/?api=1&amp;query=7855+22nd+Ave+N,+St.+Petersburg,+FL"
                    class="text-blue-300 underline underline-offset-4"
                    target="_blank"
                    rel="noopener noreferrer"
                >7855 22nd Ave N., St. Petersburg, FL</a>
            </li>
            <li>
                <p><strong>October 24, 2026</strong> — FLL Challenge Scrimmage (Lake)</p>
                <p>Montverde Academy</p>
                <a
                    href="https://www.google.com/maps/search/?api=1&amp;query=17235+Seventh+Street,+Montverde,+FL"
                    class="text-blue-300 underline underline-offset-4"
                    target="_blank"
                    rel="noopener noreferrer"
                >17235 Seventh Street, Montverde, FL</a>
            </li>
            <li>
                <p><strong>October 24, 2026</strong> — FLL Challenge Scrimmage (Hillsborough)</p>
                <p>Corbett Prep</p>
                <a
                    href="https://www.google.com/maps/search/?api=1&amp;query=12015+Orange+Grove+Drive,+Tampa,+FL"
                    class="text-blue-300 underline underline-offset-4"
                    target="_blank"
                    rel="noopener noreferrer"
                >12015 Orange Grove Drive, Tampa, FL</a>
            </li>
        </List>
    </Section>
</Layout>
