---
import copy from "@/content/site/outreach.json";
import { Image } from "astro:assets";

import H from "@/components/H.astro";
import Layout from "@/layouts/PageLayout.astro";
import Section from "@/components/Section.astro";
import List from "@/components/List.astro";
import StatGrid from "@/components/StatGrid.astro";
import tammyDennis from "@/images/2026/tammy-dennis.jpeg";
import westShoreScrimmage from "@/images/2026/west-shore-fll-scrimmage.jpg";
---

<Layout title={copy.text001} description={copy.text002}>
    <H><span class="editor-text">{copy.text003}</span></H>

    <Section>
        <p><span class="editor-text">{copy.text004}</span></p>
    </Section>

    <Section aria-labelledby="community-leadership-heading">
        <H id="community-leadership-heading" level="h2">
            <span class="editor-text">{copy.text005}</span>
        </H>
        <details class="rounded-base border border-white/20 bg-white/5">
            <summary class="showdown-summary cursor-pointer p-4 font-semibold">
                <span class="editor-text">{copy.text006}</span>
            </summary>
            <div class="space-y-4 px-4 pb-4">
                <p>
                    <strong><span class="editor-text">{copy.text007}</span></strong> <span class="editor-text">{copy.text008}</span>{" "}
                    <a
                        class="text-blue-300 underline underline-offset-4"
                        href="https://maps.app.goo.gl/7Jz1C8Vz5oYsiKVJ9"
                        target="_blank"
                        rel="noopener noreferrer"
                    >
                        <span class="editor-text">{copy.text009}</span>
                    </a>
                </p>
                <p><span class="editor-text">{copy.text010}</span></p>
                <p class="mb-0"><span class="editor-text">{copy.text011}</span></p>
                <figure class="my-6">
                    <Image
                        src={tammyDennis}
                        alt={copy.text012}
                        class="h-auto w-full rounded-base border border-silver object-cover"
                        loading="lazy"
                    />
                    <figcaption class="mt-2 text-sm"><span class="editor-text">{copy.text013}</span></figcaption>
                </figure>
                <ul class="list-disc pl-6 space-y-3 mb-6">
                    <li>
                        <strong><span class="editor-text">{copy.text014}</span></strong> <span class="editor-text">{copy.text015}</span>
                    </li>
                    <li>
                        <strong><span class="editor-text">{copy.text016}</span></strong> <span class="editor-text">{copy.text017}</span>
                    </li>
                    <li>
                        <strong><span class="editor-text">{copy.text018}</span></strong> <span class="editor-text">{copy.text019}</span>
                    </li>
                </ul>
            </div>
        </details>
        <details class="rounded-base border border-white/20 bg-white/5">
            <summary class="showdown-summary cursor-pointer p-4 font-semibold">
                <span class="editor-text">{copy.text020}</span>
            </summary>
            <div class="px-4 pb-4">
                <p class="mb-4"><span class="editor-text">{copy.text021}</span></p>
                <figure>
                    <Image
                        src={westShoreScrimmage}
                        alt={copy.text022}
                        class="aspect-[25/12] h-auto w-full rounded-base border border-silver object-cover object-bottom"
                        loading="lazy"
                    />
                </figure>
                <p class="mt-4"><span class="editor-text">{copy.text023}</span></p>
            </div>
        </details>
    </Section>

    <Section aria-labelledby="fll-competitions-heading">
        <H id="fll-competitions-heading" level="h2">
            <span class="editor-text">{copy.text024}</span>
        </H>
        <List>
            <li>
                <p>
                    <strong><span class="editor-text">{copy.text025}</span></strong> <span class="editor-text">{copy.text026}</span>
                </p>
                <p class="pl-4">
                    <span class="editor-text">{copy.text027}</span>{" "}
                    <a
                        href="https://maps.app.goo.gl/FEYV6Uz1gfULo1XdA"
                        class="text-blue-300 underline underline-offset-4"
                        target="_blank"
                        rel="noopener noreferrer"
                    >
                        <span class="editor-text">{copy.text028}</span>
                    </a>
                </p>
            </li>
            <li>
                <p>
                    <strong><span class="editor-text">{copy.text029}</span></strong> <span class="editor-text">{copy.text030}</span>
                </p>
                <p class="pl-4">
                    <span class="editor-text">{copy.text031}</span>{" "}
                    <a
                        href="https://maps.app.goo.gl/RttnUE39cU8JfbF98"
                        class="text-blue-300 underline underline-offset-4"
                        target="_blank"
                        rel="noopener noreferrer"
                    >
                        <span class="editor-text">{copy.text032}</span>
                    </a>
                </p>
            </li>
            <li>
                <p>
                    <strong><span class="editor-text">{copy.text033}</span></strong> <span class="editor-text">{copy.text034}</span>
                </p>
                <p class="pl-4">
                    <span class="editor-text">{copy.text035}</span>{" "}
                    <a
                        href="https://maps.app.goo.gl/K9wdUbZsbcURHPYp7"
                        class="text-blue-300 underline underline-offset-4"
                        target="_blank"
                        rel="noopener noreferrer"
                    >
                        <span class="editor-text">{copy.text036}</span>
                    </a>
                </p>
            </li>
        </List>
    </Section>
</Layout>

<style>
    .showdown-summary {
        display: flex;
        align-items: center;
        list-style: none;
    }

    .showdown-summary::-webkit-details-marker {
        display: none;
    }

    .showdown-summary::before {
        width: 0;
        height: 0;
        margin-right: 0.6rem;
        border-top: 4px solid transparent;
        border-bottom: 4px solid transparent;
        border-left: 6px solid currentColor;
        content: "";
        transition: transform 150ms ease;
    }

    details[open] > .showdown-summary::before {
        transform: rotate(90deg);
    }
</style>
