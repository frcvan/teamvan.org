---
import H from "@/components/H.astro";
import Layout from "@/layouts/PageLayout.astro";
import Section from "@/components/Section.astro";
import List from "@/components/List.astro";
---

<Layout title="Outreach">
    <H>Outreach</H>

    <Section aria-labelledby="community-leadership-heading">
        <H id="community-leadership-heading" level="h2">
            Community Leadership & Advocacy
        </H>
        <p class="mb-4">
            At the Space Coast Showdown, Team V.A.N. had the privilege of
            inviting and hosting guided tours for influential community leaders,
            educational advocates, and industry professionals. We shared our
            mission as a rookie FRC team and showcased how hands-on STEM
            empowers local youth across Brevard through FIRST:
        </p>
        <ul class="list-disc pl-6 space-y-3 mb-6">
            <li>
                <strong>Tammy Dennis</strong> (Brevard District 5 School Board
                Candidate) — Toured our setup and expressed strong support for
                the FIRST vision and the expansion of robotics programs across
                Brevard County schools. Viewed and interacted with most Brevard
                teams.
            </li>
            <li>
                <strong>Gordon B. Coffey</strong> (NASA Mechanical Engineer) —
                Enthusiastically viewed Florida teams' robots and offered to
                connect Team V.A.N. with professional engineering networks
                across Florida, including contacts at aerospace leaders like
                Lockheed Martin.
            </li>
            <li>
                <strong>Daniel Mondshein</strong> (Eastern Florida State College
                Collegewide Chair) — Toured with our members and offered full
                access to EFSC resources, to the best of his ability, to support
                our students' technical development and post-secondary STEM
                pathways.
            </li>
        </ul>
    </Section>

    <Section aria-labelledby="fll-competitions-heading">
        <H id="fll-competitions-heading" level="h2">
            Future Possible FLL Competitions
        </H>
        <List>
            <li>
                <p>
                    <strong>FLL Challenge Scrimmage (Pinellas)</strong> —
                    October 17, 2026
                </p>
                <p class="pl-4">
                    Azalea Middle School:{" "}
                    <a
                        href="https://maps.app.goo.gl/FEYV6Uz1gfULo1XdA"
                        class="text-blue-300 underline underline-offset-4"
                        target="_blank"
                        rel="noopener noreferrer"
                    >
                        7855 22nd Ave N., St. Petersburg, FL
                    </a>
                </p>
            </li>
            <li>
                <p>
                    <strong>FLL Challenge Scrimmage (Lake)</strong> — October
                    24, 2026
                </p>
                <p class="pl-4">
                    Montverde Academy:{" "}
                    <a
                        href="https://maps.app.goo.gl/RttnUE39cU8JfbF98"
                        class="text-blue-300 underline underline-offset-4"
                        target="_blank"
                        rel="noopener noreferrer"
                    >
                        17235 7th St, Montverde, FL
                    </a>
                </p>
            </li>
            <li>
                <p>
                    <strong>FLL Challenge Scrimmage (Hillsborough)</strong> —
                    October 24, 2026
                </p>
                <p class="pl-4">
                    Corbett Preparatory School:{" "}
                    <a
                        href="https://maps.app.goo.gl/K9wdUbZsbcURHPYp7"
                        class="text-blue-300 underline underline-offset-4"
                        target="_blank"
                        rel="noopener noreferrer"
                    >
                        12015 Orange Grove Drive, Tampa, FL
                    </a>
                </p>
            </li>
        </List>
    </Section>
</Layout>
