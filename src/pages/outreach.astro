---
import copy from "@/content/site/outreach.json";
import { Image } from "astro:assets";

import H from "@/components/H.astro";
import Layout from "@/layouts/PageLayout.astro";
import Section from "@/components/Section.astro";
import List from "@/components/List.astro";
import StatGrid from "@/components/StatGrid.astro";
import tammyDennis from "@/images/2026/tammy-dennis.jpeg";
import westShoreScrimmage from "@/images/2026/west-shore-fll-scrimmage.jpg";
---

<Layout title={copy.text001} description={copy.text002}>
    <H>{copy.text003}</H>

    <Section>
        <p>{copy.text004}</p>
    </Section>

    <Section aria-labelledby="community-leadership-heading">
        <H id="community-leadership-heading" level="h2">
            {copy.text005}
        </H>
        <details class="rounded-base border border-white/20 bg-white/5">
            <summary class="showdown-summary cursor-pointer p-4 font-semibold">
                {copy.text006}
            </summary>
            <div class="space-y-4 px-4 pb-4">
                <p>
                    <strong>{copy.text007}</strong> {copy.text008}{" "}
                    <a
                        class="text-blue-300 underline underline-offset-4"
                        href="https://maps.app.goo.gl/7Jz1C8Vz5oYsiKVJ9"
                        target="_blank"
                        rel="noopener noreferrer"
                    >
                        {copy.text009}
                    </a>
                </p>
                <p>{copy.text010}</p>
                <p class="mb-0">{copy.text011}</p>
                <figure class="my-6">
                    <Image
                        src={tammyDennis}
                        alt={copy.text012}
                        class="h-auto w-full rounded-base border border-silver object-cover"
                        loading="lazy"
                    />
                    <figcaption class="mt-2 text-sm">{copy.text013}</figcaption>
                </figure>
                <ul class="list-disc pl-6 space-y-3 mb-6">
                    <li>
                        <strong>{copy.text014}</strong> {copy.text015}
                    </li>
                    <li>
                        <strong>{copy.text016}</strong> {copy.text017}
                    </li>
                    <li>
                        <strong>{copy.text018}</strong> {copy.text019}
                    </li>
                </ul>
            </div>
        </details>
        <details class="rounded-base border border-white/20 bg-white/5">
            <summary class="showdown-summary cursor-pointer p-4 font-semibold">
                {copy.text020}
            </summary>
            <div class="px-4 pb-4">
                <p class="mb-4">{copy.text021}</p>
                <figure>
                    <Image
                        src={westShoreScrimmage}
                        alt={copy.text022}
                        class="aspect-[25/12] h-auto w-full rounded-base border border-silver object-cover object-bottom"
                        loading="lazy"
                    />
                </figure>
                <p class="mt-4">{copy.text023}</p>
            </div>
        </details>
    </Section>

    <Section aria-labelledby="fll-competitions-heading">
        <H id="fll-competitions-heading" level="h2">
            {copy.text024}
        </H>
        <List>
            <li>
                <p>
                    <strong>{copy.text025}</strong> {copy.text026}
                </p>
                <p class="pl-4">
                    {copy.text027}{" "}
                    <a
                        href="https://maps.app.goo.gl/FEYV6Uz1gfULo1XdA"
                        class="text-blue-300 underline underline-offset-4"
                        target="_blank"
                        rel="noopener noreferrer"
                    >
                        {copy.text028}
                    </a>
                </p>
            </li>
            <li>
                <p>
                    <strong>{copy.text029}</strong> {copy.text030}
                </p>
                <p class="pl-4">
                    {copy.text031}{" "}
                    <a
                        href="https://maps.app.goo.gl/RttnUE39cU8JfbF98"
                        class="text-blue-300 underline underline-offset-4"
                        target="_blank"
                        rel="noopener noreferrer"
                    >
                        {copy.text032}
                    </a>
                </p>
            </li>
            <li>
                <p>
                    <strong>{copy.text033}</strong> {copy.text034}
                </p>
                <p class="pl-4">
                    {copy.text035}{" "}
                    <a
                        href="https://maps.app.goo.gl/K9wdUbZsbcURHPYp7"
                        class="text-blue-300 underline underline-offset-4"
                        target="_blank"
                        rel="noopener noreferrer"
                    >
                        {copy.text036}
                    </a>
                </p>
            </li>
        </List>
    </Section>
</Layout>

<style>
    .showdown-summary {
        display: flex;
        align-items: center;
        list-style: none;
    }

    .showdown-summary::-webkit-details-marker {
        display: none;
    }

    .showdown-summary::before {
        width: 0;
        height: 0;
        margin-right: 0.6rem;
        border-top: 4px solid transparent;
        border-bottom: 4px solid transparent;
        border-left: 6px solid currentColor;
        content: "";
        transition: transform 150ms ease;
    }

    details[open] > .showdown-summary::before {
        transform: rotate(90deg);
    }
</style>
