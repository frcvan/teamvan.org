---
import copy from "@/content/site/competitions.json";
import H from "@/components/H.astro";
import Layout from "@/layouts/PageLayout.astro";
import Section from "@/components/Section.astro";
import List from "@/components/List.astro";
---

<Layout title={copy.text001} description={copy.text002}>
    <H><span class="editor-text">{copy.text003}</span></H>

    <Section aria-labelledby="this-season-heading">
        <H id="this-season-heading" level="h2">
            <span class="editor-text">{copy.text004}</span>
        </H>
        <p><span class="editor-text">{copy.text005}</span></p>
    </Section>

    <Section aria-labelledby="how-it-works-heading">
        <H id="how-it-works-heading" level="h2">
            <span class="editor-text">{copy.text006}</span>
        </H>
        <p><span class="editor-text">{copy.text007}</span></p>
        <p><span class="editor-text">{copy.text008}</span></p>
    </Section>

    <Section>
        <H level="h2"><span class="editor-text">{copy.text009}</span></H>
        <List>
            <li>
                <div>
                    <strong><span class="editor-text">{copy.text010}</span></strong> <span class="editor-text">{copy.text011}</span>
                </div>
                <p class="pl-4">
                    <span class="editor-text">{copy.text012}</span>{" "}
                    <a
                        class="text-blue-300 underline underline-offset-4"
                        href="https://maps.app.goo.gl/TCpkcVxykxKyBhj96"
                        target="_blank"
                        rel="noopener noreferrer"
                    >
                        <span class="editor-text">{copy.text013}</span>
                    </a>
                </p>
            </li>
            <li>
                <div>
                    <strong><span class="editor-text">{copy.text014}</span></strong> <span class="editor-text">{copy.text015}</span>
                </div>
                <p class="pl-4">
                    <span class="editor-text">{copy.text016}</span>{" "}
                    <a
                        class="text-blue-300 underline underline-offset-4"
                        href="https://maps.app.goo.gl/bXVT8S6Mk8nxYPgM6"
                        target="_blank"
                        rel="noopener noreferrer"
                    >
                        <span class="editor-text">{copy.text017}</span>
                    </a>
                </p>
            </li>
            <li>
                <div>
                    <strong><span class="editor-text">{copy.text018}</span></strong>
                </div>
                <p class="pl-4"><span class="editor-text">{copy.text019}</span></p>
            </li>
        </List>
    </Section>

    <Section aria-labelledby="follow-along-heading">
        <H id="follow-along-heading" level="h2">
            <span class="editor-text">{copy.text020}</span>
        </H>
        <p>
            <span class="editor-text">{copy.text021}</span>{" "}
            <a
                class="text-blue-300 underline underline-offset-4"
                href="https://www.thebluealliance.com/team/12148"
                target="_blank"
                rel="noopener noreferrer"
            >
                <span class="editor-text">{copy.text022}</span>
            </a>
            <span class="editor-text">{copy.text023}</span>{" "}
            <a
                href="/calendar/"
                class="text-blue-300 underline underline-offset-4"
            >
                <span class="editor-text">{copy.text024}</span>
            </a>{" "}
            <span class="editor-text">{copy.text025}</span>
        </p>
    </Section>
</Layout>
