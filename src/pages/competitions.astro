---
import PageHeader from "@/components/PageHeader.astro";
import Layout from "@/layouts/PageLayout.astro";
---

<Layout>
    <PageHeader>Competitions</PageHeader>
    <section class="mt-12 space-y-6">
        <div class="space-y-3">
            <h2 class="text-lg font-semibold tracking-tight sm:text-xl">
                FRC regional competitions we plan to attend:
            </h2>
            <ul class="list-disc space-y-3 pl-6">
                <li>
                    <div>
                        <strong>Orlando Regional</strong> — March 17-20, 2027.
                    </div>
                    <p class="mt-1 pl-4 text-sm"></p>
                </li>
                <li>
                    <div>
                        <strong>Rocket City Regional</strong> — April 7-10,
                        2027.
                    </div>
                    <p class="mt-1 pl-4 text-sm"></p>
                </li>
            </ul>
        </div>

        <div class="space-y-2">
            <h2 class="text-lg font-semibold tracking-tight sm:text-xl">
                Our goal
            </h2>
            <p>
                At each competition, our goal is simple: do our best, learn as
                much as possible, and compete with pride. As a rookie team, we
                aim to show strong effort, teamwork, and improvement while
                pursuing the{" "}
                <span class="underline underline-offset-4">
                    Rookie All-Star
                </span>{" "}
                award, which is given to a first-year team that stands out for
                leadership, professionalism, and being a great teammate to
                everyone around them.
            </p>
        </div>
    </section>
</Layout>
