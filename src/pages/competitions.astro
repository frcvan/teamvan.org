---
import H from "@/components/H.astro";
import Layout from "@/layouts/PageLayout.astro";
import Section from "@/components/Section.astro";
import List from "@/components/List.astro";
---

<Layout
    title="Competitions"
    description="Follow Team V.A.N.'s offseason events and planned FIRST Robotics Competition regionals in Florida and Alabama."
>
    <H>Competitions</H>

    <Section aria-labelledby="how-it-works-heading">
        <H id="how-it-works-heading" level="h2">
            How qualifying for Worlds works
        </H>
        <p>
            Team V.A.N. is a Regional-style state, which means our registration
            covers one regional event rather than a district season. We qualify
            for the FIRST Championship directly out of a regional by placing
            well enough in the event's rankings and playoffs, or by winning
            certain awards that carry an automatic bid, such as the Regional
            Impact Award or an Engineering Inspiration Award.
        </p>
        <p>
            This season we'll be registered for two regionals, the Orlando
            Regional and the Rocket City Regional, so we get two chances to
            qualify.
        </p>
    </Section>

    <Section>
        <H level="h2">Offseason Competitions</H>
        <List>
            <li>
                <div>
                    <strong>Space Coast Showdown</strong> — September 26, 2026
                </div>
                <p class="pl-4">
                    Valiant Air Command Warbird Museum:{" "}
                    <a
                        class="text-blue-300 underline underline-offset-4"
                        href="https://maps.app.goo.gl/7Jz1C8Vz5oYsiKVJ9"
                        target="_blank"
                        rel="noopener noreferrer"
                    >
                        6600 Tico Rd, Titusville, FL
                    </a>
                </p>
                <p class="pl-4 mt-2">
                    Our team had an extremely successful day volunteering at the
                    Space Coast Showdown! In addition to keeping matches running
                    smoothly as field resetters in the morning hours of the
                    competition, our members proudly served as ambassadors for
                    Team V.A.N. and FIRST Florida, engaging with NASA employees,
                    Eastern Florida State College (EFSC) directors, and school
                    board member candidates.
                </p>
            </li>
        </List>
    </Section>

    <Section>
        <H level="h2">FRC regionals we plan to attend:</H>
        <List>
            <li>
                <div>
                    <strong>Orlando Regional</strong> — March 17-20, 2027
                </div>
                <p class="pl-4">
                    Addition Financial Arena:{" "}
                    <a
                        class="text-blue-300 underline underline-offset-4"
                        href="https://maps.app.goo.gl/TCpkcVxykxKyBhj96"
                        target="_blank"
                        rel="noopener noreferrer"
                    >
                        12777 Gemini Blvd N, Orlando, FL
                    </a>
                </p>
            </li>
            <li>
                <div>
                    <strong>Rocket City Regional</strong> — April 7-10, 2027
                </div>
                <p class="pl-4">
                    Von Braun Center:{" "}
                    <a
                        class="text-blue-300 underline underline-offset-4"
                        href="https://maps.app.goo.gl/bXVT8S6Mk8nxYPgM6"
                        target="_blank"
                        rel="noopener noreferrer"
                    >
                        700 Monroe St SW, Huntsville, AL
                    </a>
                </p>
            </li>
            <li>
                <div>
                    <strong>FIRST Championship</strong>
                </div>
                <p class="pl-4">If we qualify.</p>
            </li>
        </List>
    </Section>

    <Section aria-labelledby="follow-along-heading">
        <H id="follow-along-heading" level="h2">
            Follow along
        </H>
        <p>
            Match schedules, rankings, and results for every FRC event are
            public, including ours once we start competing. Live scores and
            standings for an event are posted on{" "}
            <a
                class="text-blue-300 underline underline-offset-4"
                href="https://www.thebluealliance.com/"
                target="_blank"
                rel="noopener noreferrer"
            >
                The Blue Alliance
            </a>{" "}
            and advanced team statistics on{" "}
            <a
                class="text-blue-300 underline underline-offset-4"
                href="https://www.statbotics.io/"
                target="_blank"
                rel="noopener noreferrer"
            >
                Statbotics
            </a>{" "}
            — search "Team 12148" once we've competed at an event. Our{" "}
            <a
                href="/calendar/"
                class="text-blue-300 underline underline-offset-4"
            >
                calendar
            </a>{" "}
            page has event dates as they're finalized.
        </p>
    </Section>
</Layout>
