---
import copy from "@/content/site/competitions.json";
import H from "@/components/H.astro";
import Layout from "@/layouts/PageLayout.astro";
import Section from "@/components/Section.astro";
import List from "@/components/List.astro";
---

<Layout title={copy.text001} description={copy.text002}>
    <H>{copy.text003}</H>

    <Section aria-labelledby="this-season-heading">
        <H id="this-season-heading" level="h2">
            {copy.text004}
        </H>
        <p>{copy.text005}</p>
    </Section>

    <Section aria-labelledby="how-it-works-heading">
        <H id="how-it-works-heading" level="h2">
            {copy.text006}
        </H>
        <p>{copy.text007}</p>
        <p>{copy.text008}</p>
    </Section>

    <Section>
        <H level="h2">{copy.text009}</H>
        <List>
            <li>
                <div>
                    <strong>{copy.text010}</strong> {copy.text011}
                </div>
                <p class="pl-4">
                    {copy.text012}{" "}
                    <a
                        class="text-blue-300 underline underline-offset-4"
                        href="https://maps.app.goo.gl/TCpkcVxykxKyBhj96"
                        target="_blank"
                        rel="noopener noreferrer"
                    >
                        {copy.text013}
                    </a>
                </p>
            </li>
            <li>
                <div>
                    <strong>{copy.text014}</strong> {copy.text015}
                </div>
                <p class="pl-4">
                    {copy.text016}{" "}
                    <a
                        class="text-blue-300 underline underline-offset-4"
                        href="https://maps.app.goo.gl/bXVT8S6Mk8nxYPgM6"
                        target="_blank"
                        rel="noopener noreferrer"
                    >
                        {copy.text017}
                    </a>
                </p>
            </li>
            <li>
                <div>
                    <strong>{copy.text018}</strong>
                </div>
                <p class="pl-4">{copy.text019}</p>
            </li>
        </List>
    </Section>

    <Section aria-labelledby="follow-along-heading">
        <H id="follow-along-heading" level="h2">
            {copy.text020}
        </H>
        <p>
            {copy.text021}{" "}
            <a
                class="text-blue-300 underline underline-offset-4"
                href="https://www.thebluealliance.com/team/12148"
                target="_blank"
                rel="noopener noreferrer"
            >
                {copy.text022}
            </a>
            {copy.text023}{" "}
            <a
                href="/calendar/"
                class="text-blue-300 underline underline-offset-4"
            >
                {copy.text024}
            </a>{" "}
            {copy.text025}
        </p>
    </Section>
</Layout>
