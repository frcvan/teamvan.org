---
import H from "@/components/H.astro";
import Layout from "@/layouts/PageLayout.astro";
import Section from "@/components/Section.astro";
import List from "@/components/List.astro";
---

<Layout title="Competitions">
    <H>Competitions</H>
    <Section>
        <H level="h2">FRC regionals we plan to attend:</H>
        <List>
            <li>
                <div>
                    <strong>Orlando Regional</strong> — March 17-20, 2027.
                </div>
                <p class="pl-4">
                    <a
                        class="text-blue-300 underline underline-offset-4"
                        href="https://maps.app.goo.gl/TCpkcVxykxKyBhj96"
                        target="_blank"
                        rel="noopener noreferrer"
                    >
                        Addition Financial Arena, Orlando, FL
                    </a>
                </p>
            </li>
            <li>
                <div>
                    <strong>Rocket City Regional</strong> — April 7-10, 2027.
                </div>
                <p class="pl-4">
                    <a
                        class="text-blue-300 underline underline-offset-4"
                        href="https://maps.app.goo.gl/bXVT8S6Mk8nxYPgM6"
                        target="_blank"
                        rel="noopener noreferrer"
                    >
                        Von Braun Center, Huntsville, AL
                    </a>
                </p>
            </li>
        </List>
    </Section>
</Layout>
