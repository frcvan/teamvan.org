---
import PageHeader from "@/components/PageHeader.astro";
import Layout from "@/layouts/PageLayout.astro";
---

<Layout wide>
    <PageHeader>Competitions</PageHeader>
    <section
        class="mt-12 space-y-4 rounded-xl border-2 border-black bg-white p-6 text-main"
        aria-labelledby="planned-competitions"
    >
        <h2 id="planned-competitions" class="text-lg font-semibold tracking-tight sm:text-xl">
            FRC regional competitions we plan to attend:
        </h2>
    </section>
</Layout>
