---
import { Content, frontmatter } from "@/content/pages/ftc.mdx";

import PageHero from "@/components/PageHero.astro";
import Layout from "@/layouts/PageLayout.astro";
import components from "@/components/mdx";
import heroFtc from "@/images/pages/hero-ftc.jpg";
---

<Layout title={frontmatter.title} description={frontmatter.description}>
    <PageHero
        slot="hero"
        image={heroFtc}
        alt="Two FIRST Tech Challenge robots on the field beside the goals while referees and spectators watch"
        kicker="FIRST Tech Challenge · Grades 7 to 12"
        title="Start an FTC Team"
        blurb="A metal robot, a Florida league, and a season that starts in September. Two coaches and one kit are enough to begin."
        credit="U.S. Embassy Tel Aviv, CC BY 2.0"
        creditHref="https://commons.wikimedia.org/wiki/File:FIRST_Finals-_Lego_League_and_Tech_Challenge_(32408443393).jpg"
    />
    <Content components={components} />
</Layout>
