---
import Layout from "@/layouts/BaseLayout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";

interface Props {
    title?: string;
}

const { title } = Astro.props;
---

<Layout title={title}>
    <a
        href="#main-content"
        class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:rounded-base focus:border-2 focus:border-black focus:bg-white focus:px-4 focus:py-2 focus:text-main focus:no-underline"
    >
        Skip to content
    </a>
    <Header
        navlinks={[
            { href: "/", label: "Home" },
            { href: "/calendar/", label: "Calendar" },
            { href: "/competitions/", label: "Competitions" },
            { href: "/outreach/", label: "Outreach" },
            { href: "/sponsors/", label: "For Sponsors" },
            { href: "/interest/", label: "Join Now" },
        ]}
    />
    <main
        id="main-content"
        class="mx-auto flex min-h-0 w-full max-w-5xl flex-1 flex-col px-6 pt-16 sm:px-10 lg:px-12"
    >
        <slot />
    </main>
    <Footer />
</Layout>
