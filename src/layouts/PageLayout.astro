---
import Layout from "@/layouts/BaseLayout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";

interface Props {
    wide?: boolean;
    fullWidth?: boolean;
}

const { wide = false, fullWidth = false } = Astro.props;
---

<Layout>
    <a
        href="#main-content"
        class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:rounded-base focus:border-2 focus:border-black focus:bg-white focus:px-4 focus:py-2 focus:text-main focus:no-underline"
    >
        Skip to content
    </a>
    <Header
        navlinks={[
            { href: "/", label: "Home" },
            { href: "/calendar/", label: "Calendar" },
            { href: "/competitions/", label: "Competitions" },
            { href: "/outreach/", label: "Outreach" },
            { href: "/sponsors/", label: "For Sponsors" },
            {
                href: "/interest/",
                label: "Interested?",
                labelClass: "underline decoration-silver underline-offset-4",
            },
        ]}
    />
    <main
        id="main-content"
        class:list={[
            "mx-auto flex min-h-0 w-full flex-1 flex-col pt-16",
            fullWidth
                ? "px-4 sm:px-6 lg:px-8"
                : [
                      "px-6 sm:px-10 lg:px-20 xl:px-32",
                      wide ? "max-w-6xl" : "max-w-4xl",
                  ],
        ]}
    >
        <slot />
    </main>
    <Footer />
</Layout>
