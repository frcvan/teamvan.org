---
import Layout from "@/layouts/BaseLayout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";

interface Props {
    title?: string;
    description?: string;
}

const { title, description } = Astro.props;
---

<Layout title={title} description={description}>
    <a
        href="#main-content"
        class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:rounded-base focus:border-2 focus:border-rule focus:bg-secondary-background focus:px-4 focus:py-2 focus:text-main focus:no-underline"
    >
        Skip to content
    </a>
    <Header
        navlinks={[
            { href: "/", label: "About Us" },
            { href: "/calendar/", label: "Calendar" },
            { href: "/outreach/", label: "Outreach" },
            {
                href: "/updates/",
                label: "Resources",
                children: [
                    { href: "/updates/", label: "Updates" },
                    { href: "/about/", label: "What Is FIRST" },
                    { href: "/competitions/", label: "Competitions" },
                    { href: "/fll/", label: "Start an FLL Team" },
                    { href: "/ftc/", label: "Start an FTC Team" },
                ],
            },
            { href: "/sponsors/", label: "Sponsors" },
            { href: "/join/", label: "Join" },
        ]}
    />
    <slot name="hero" />
    <main
        id="main-content"
        class="mx-auto flex min-h-0 w-full max-w-5xl flex-1 flex-col px-6 pt-16 sm:px-10 lg:px-12"
    >
        <slot />
    </main>
    <Footer />
</Layout>
