---
import "@/styles/global.css";

export interface Props {
    title?: string;
}

const { title } = Astro.props as Props;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" type="image/x-icon" href="/favicon.ico" />
        <meta name="generator" content={Astro.generator} />
        <meta
            name="description"
            content="Team V.A.N. is a FIRST Robotics (FRC) team based out of Palm Bay, supporting Brevard and Indian River County, empowering student leaders."
        />
        <link rel="sitemap" href="/sitemap-index.xml" />
        <title>{title ? `${title} - ` : ""}Team V.A.N.</title>

        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Merriweather+Sans:ital,wght@0,300..800;1,300..800&display=swap"
            rel="stylesheet"
        />
    </head>
    <body class="bg-main m-0 flex min-h-screen w-full flex-col">
        <slot />
    </body>
</html>
