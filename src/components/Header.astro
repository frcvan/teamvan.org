---
import { Icon } from "astro-icon/components";

import Navigation from "@/components/Navigation.astro";
import Button from "@/components/Button.astro";

import VanLogo from "@/images/van-logo.svg";

interface NavChild {
    href: string;
    label: string;
}

interface NavLink {
    href: string;
    label: string;
    labelClass?: string;
    children?: NavChild[];
}

interface Props {
    navlinks: NavLink[];
}

const { navlinks } = Astro.props as Props;
const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const isCurrent = (href: string) =>
    (href.replace(/\/$/, "") || "/") === currentPath;
const navigationLinks = navlinks.map((navlink) => ({
    ...navlink,
    // A section stays marked as the current page on any of its child pages.
    active:
        isCurrent(navlink.href) ||
        (navlink.children?.some((child) => isCurrent(child.href)) ?? false),
    children: navlink.children?.map((child) => ({
        ...child,
        active: isCurrent(child.href),
    })),
}));
---

<header class="site-header sticky top-0 z-30">
    <div
        class="absolute inset-x-0 top-0 h-0.75 origin-left scale-x-0 bg-link"
        data-scroll-progress
        aria-hidden="true"
    ></div>
    <div class="header-bar h-full border-rule bg-secondary-background border-b-4">
        <div class="header-inner mx-auto flex h-full w-full max-w-7xl flex-wrap items-center justify-between gap-4 px-6 lg:gap-6">
            <a
                class="text-brand flex min-w-0 flex-1 items-center no-underline lg:flex-none"
                href="/"
                aria-label="Team V.A.N. home"
            >
                <span
                    class="logo-type flex items-baseline whitespace-nowrap leading-none lg:text-[3rem]"
                    aria-hidden="true"
                >
                    <VanLogo
                        width="1280"
                        height="448"
                        class="block size-12 shrink-0 fill-[var(--logo-front)]! sm:size-14 lg:size-[0.74em]"
                    />
                    <span class="hidden lg:block lg:-ml-[0.11em]">.A.N.</span>
                </span>
            </a>

            <div class="hidden lg:block">
                <Navigation navlinks={navigationLinks} class="flex-none!" />
            </div>

            <details class="mobile-menu group shrink-0 text-main lg:hidden">
                <summary
                    aria-label="Open navigation menu"
                    aria-controls="mobile-navigation"
                    class="relative z-30 ml-auto flex min-h-11 min-w-11 w-fit cursor-pointer list-none items-center justify-center focus-visible:outline-2 focus-visible:outline-offset-4 [&::-webkit-details-marker]:hidden"
                >
                    <Icon
                        name="tabler:menu"
                        size={32}
                        class="group-open:hidden"
                    />
                    <Icon
                        name="tabler:x"
                        size={32}
                        class="hidden group-open:block"
                    />
                </summary>
                <nav
                    id="mobile-navigation"
                    aria-label="Main navigation"
                    class="mobile-menu-nav fixed inset-0 z-20 flex flex-col gap-3 overflow-y-auto bg-page px-6 pt-28 pb-10"
                >
                    {navigationLinks.map((link) =>
                        link.children?.length ? (
                            <div class="mobile-menu-item grid gap-2">
                                <Button
                                    href={link.href}
                                    current={link.active}
                                    variant={link.active ? "primary" : "ghost"}
                                    outline={false}
                                    size="lg"
                                    class:list={[
                                        "w-full justify-start border-2 border-rule hover:border-main",
                                        link.labelClass || "",
                                    ]}
                                >
                                    {link.label}
                                </Button>
                                <div class="grid gap-2 border-l-4 border-rule pl-4">
                                    {link.children.map((child) => (
                                        <Button
                                            href={child.href}
                                            current={child.active}
                                            variant={
                                                child.active
                                                    ? "primary"
                                                    : "ghost"
                                            }
                                            outline={false}
                                            class="w-full justify-start border-2 border-rule hover:border-main"
                                        >
                                            {child.label}
                                        </Button>
                                    ))}
                                </div>
                            </div>
                        ) : (
                            <Button
                                href={link.href}
                                current={link.active}
                                variant={link.active ? "primary" : "ghost"}
                                outline={false}
                                size="lg"
                                class:list={[
                                    "mobile-menu-item w-full justify-start border-2 border-rule hover:border-main",
                                    link.labelClass || "",
                                ]}
                            >
                                {link.label}
                            </Button>
                        ),
                    )}
                </nav>
            </details>
        </div>
    </div>
</header>

<script>
    const menu = document.querySelector<HTMLDetailsElement>(".mobile-menu");
    const header = document.querySelector<HTMLElement>(".site-header");
    const progress = document.querySelector<HTMLElement>(
        "[data-scroll-progress]",
    );

    menu?.addEventListener("toggle", () => {
        document.body.classList.toggle("menu-open", menu.open);
    });

    document.addEventListener("click", (event) => {
        if (!menu?.open) return;
        if (
            event.target instanceof Element &&
            event.target.closest(".mobile-menu-item")
        ) {
            menu.open = false;
        }
    });

    document.addEventListener("keydown", (event) => {
        if (event.key === "Escape" && menu?.open) menu.open = false;
    });

    const desktop = window.matchMedia("(min-width: 64rem)");
    desktop.addEventListener("change", (event) => {
        if (event.matches && menu) menu.open = false;
    });

    if (header && progress) {
        let frame = 0;
        let scrolled = false;
        const update = () => {
            const y = window.scrollY;
            // Hysteresis keeps the shrink from flickering at the threshold.
            if (y > 32 && !scrolled) {
                scrolled = true;
                header.classList.add("is-scrolled");
            } else if (y < 4 && scrolled) {
                scrolled = false;
                header.classList.remove("is-scrolled");
            }
            const scrollable =
                document.documentElement.scrollHeight - window.innerHeight;
            const ratio = scrollable > 0 ? Math.min(y / scrollable, 1) : 0;
            progress.style.transform = `scaleX(${ratio})`;
            frame = 0;
        };
        window.addEventListener(
            "scroll",
            () => {
                if (!frame) frame = requestAnimationFrame(update);
            },
            { passive: true },
        );
        window.addEventListener("resize", update);
        update();
    }
</script>

<style>
    /* Header wordmark: the checker "V" sits at 0.74em so its cap height
       matches Archivo Black. The mark and the wordmark each cast a single
       solid offset shadow, so the logo never shows more than one shadow
       color. */
    .logo-type {
        font-family: "Archivo Black", "Helvetica Neue", sans-serif;
        font-weight: 400;
        color: var(--logo-front);
        text-shadow: 4px 4px 0 var(--logo-shadow);
    }

    .logo-type svg {
        filter: drop-shadow(4px 4px 0 var(--logo-shadow));
    }

    /* Sticky header: the outer box keeps its height so the page never shifts;
       only the painted bar (and the wordmark) gets shorter on scroll. Content
       scrolls behind the transparent remainder of the outer box, so the bar
       reads as shorter while the document below it stays put. */
    .site-header {
        height: 6rem;
    }

    .site-header .header-bar {
        height: 100%;
        transition: height 200ms ease-out;
    }

    .site-header .logo-type {
        transition: font-size 200ms ease-out;
    }

    .site-header.is-scrolled .header-bar {
        height: 4.5rem;
    }

    @media (min-width: 64rem) {
        .site-header.is-scrolled .logo-type {
            font-size: 2.25rem;
        }
    }

    /* Full-screen mobile menu: lock the page behind it and stagger the links. */
    :global(body.menu-open) {
        overflow: hidden;
    }

    @keyframes mobile-menu-in {
        from {
            opacity: 0;
            transform: translateY(-8px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @keyframes menu-item-in {
        from {
            opacity: 0;
            transform: translateY(12px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .mobile-menu[open] .mobile-menu-nav {
        animation: mobile-menu-in 180ms ease-out both;
    }

    .mobile-menu[open] .mobile-menu-item {
        animation: menu-item-in 300ms cubic-bezier(0.22, 1, 0.36, 1) both;
    }

    .mobile-menu[open] .mobile-menu-item:nth-child(2) {
        animation-delay: 40ms;
    }

    .mobile-menu[open] .mobile-menu-item:nth-child(3) {
        animation-delay: 80ms;
    }

    .mobile-menu[open] .mobile-menu-item:nth-child(4) {
        animation-delay: 120ms;
    }

    .mobile-menu[open] .mobile-menu-item:nth-child(5) {
        animation-delay: 160ms;
    }

    .mobile-menu[open] .mobile-menu-item:nth-child(6) {
        animation-delay: 200ms;
    }

    .mobile-menu[open] .mobile-menu-item:nth-child(7) {
        animation-delay: 240ms;
    }

    /* In dark mode the menu icon uses the light link red with a maroon offset. */
    :global(:root[data-theme="dark"]) .mobile-menu summary svg {
        color: var(--link);
        filter: drop-shadow(2px 2px 0 var(--crimson));
    }
</style>
