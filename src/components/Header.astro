---
import Navigation from "@/components/Navigation.tsx";
import { Menu } from "lucide-react";

interface Props {
    navlinks: { href: string; label: string; labelClass?: string }[];
}

const { navlinks } = Astro.props;
const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const navigationLinks = navlinks.map((navlink) => ({
    ...navlink,
    active: (navlink.href.replace(/\/$/, "") || "/") === currentPath,
}));
---

<header class="relative border-silver bg-secondary-background border-b-2">
    <div class="mx-auto flex w-full max-w-7xl items-center justify-between gap-4 px-6 py-6 lg:gap-6">
        <a
            class="text-main flex min-w-0 items-center gap-3 text-xl font-extrabold no-underline sm:text-2xl"
            href="/"
            aria-label="Team V.A.N. home"
        >
            <img
                src="/favicon.svg"
                alt=""
                width="48"
                height="48"
                class="block size-10 shrink-0 sm:size-12"
                style="color-scheme: light"
                aria-hidden="true"
            />
            <span class="hidden lg:block">Team V.A.N. 12148</span>
        </a>

        <div class="hidden lg:block">
            <Navigation navlinks={navigationLinks} className="flex-none!" />
        </div>

        <details class="mobile-menu shrink-0 text-main lg:hidden">
            <summary
                aria-label="Open navigation menu"
                aria-controls="mobile-navigation"
                class="ml-auto flex min-h-11 min-w-11 w-fit cursor-pointer list-none items-center justify-center focus-visible:outline-2 focus-visible:outline-offset-4"
            >
                <Menu size={32} aria-hidden="true" />
            </summary>
            <nav
                id="mobile-navigation"
                aria-label="Main navigation"
                class="mobile-menu-nav absolute inset-x-0 top-full z-20 flex flex-col gap-2 border-b-2 border-silver bg-secondary-background px-6 py-4"
            >
                {navigationLinks.map((link, index) => (
                    <a
                        href={link.href}
                        aria-current={link.active ? "page" : undefined}
                        style={`--mobile-menu-item-index: ${index};`}
                        class:list={[
                            "mobile-menu-item rounded-base border-2 px-4 py-3 font-semibold focus-visible:outline-2 focus-visible:outline-offset-2",
                            link.active
                                ? "border-black bg-main text-white"
                                : "border-transparent hover:border-black hover:bg-main hover:text-white",
                            link.labelClass || "",
                        ]}
                    >
                        {link.label}
                    </a>
                ))}
            </nav>
        </details>
    </div>
</header>

<style>
    .mobile-menu summary::-webkit-details-marker {
        display: none;
    }
</style>
