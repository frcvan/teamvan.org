---
import { Icon } from "astro-icon/components";

import Navigation from "@/components/Navigation.astro";
import Button from "@/components/Button.astro";

interface Props {
    navlinks: { href: string; label: string; labelClass?: string }[];
}

const { navlinks } = Astro.props as Props;
const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const navigationLinks = navlinks.map((navlink) => ({
    ...navlink,
    active: (navlink.href.replace(/\/$/, "") || "/") === currentPath,
}));
---

<header class="relative border-silver bg-secondary-background border-b-2">
    <div class="mx-auto flex w-full max-w-7xl flex-wrap items-center justify-between gap-4 px-6 py-6 lg:gap-6">
        <a
            class="text-main flex min-w-0 flex-1 items-center text-base font-extrabold no-underline sm:text-xl lg:flex-none lg:text-2xl"
            href="/"
            aria-label="Team V.A.N. home"
        >
            <img
                src="/team-van-logo.png?v=van-wordmark-red-1"
                alt=""
                width="1280"
                height="448"
                loading="eager"
                class="block h-auto w-36 shrink-0 sm:w-44"
                aria-hidden="true"
            />
        </a>

        <div class="hidden lg:block">
            <Navigation navlinks={navigationLinks} class="flex-none!" />
        </div>

        <details class="mobile-menu shrink-0 text-main lg:hidden">
            <summary
                aria-label="Open navigation menu"
                aria-controls="mobile-navigation"
                class="ml-auto flex min-h-11 min-w-11 w-fit cursor-pointer list-none items-center justify-center focus-visible:outline-2 focus-visible:outline-offset-4"
            >
                <Icon name="tabler:menu" size={32} />
            </summary>
            <nav
                id="mobile-navigation"
                aria-label="Main navigation"
                class="mobile-menu-nav absolute inset-x-0 top-full z-20 flex flex-col gap-2 border-b-2 border-silver bg-secondary-background px-6 py-4"
            >
                {navigationLinks.map((link) => (
                    <Button
                        href={link.href}
                        current={link.active}
                        variant={link.active ? "primary" : "ghost"}
                        size="lg"
                        class:list={[
                            "mobile-menu-item rounded-base border-2 px-4 py-3 font-semibold focus-visible:outline-2 focus-visible:outline-offset-2",
                            link.labelClass || "",
                        ]}
                    >
                        {link.label}
                    </Button>
                ))}
            </nav>
        </details>
    </div>
</header>

<script>
    document.addEventListener("click", (event) => {
        const target = event.target;
        if (!(target instanceof Node)) return;

        document.querySelectorAll<HTMLDetailsElement>(".mobile-menu[open]").forEach((menu) => {
            if (!menu.contains(target)) {
                menu.open = false;
            }
        });
    });
</script>

<style>
    .mobile-menu summary::-webkit-details-marker {
        display: none;
    }
</style>
