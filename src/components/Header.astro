---
import Navigation from "@/components/Navigation.tsx";

interface Props {
    navlinks: { href: string; label: string }[];
}

const { navlinks } = Astro.props;
const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const navigationLinks = navlinks.map((navlink) => ({
    ...navlink,
    active: (navlink.href.replace(/\/$/, "") || "/") === currentPath,
}));
const currentPage = navigationLinks.find((link) => link.active)?.label;
---

<header class="border-border bg-secondary-background border-b-2">
    <div class="mx-auto flex w-full max-w-7xl flex-wrap items-center justify-between gap-4 px-6 py-6 lg:flex-nowrap lg:gap-6">
        <a
            class="text-main flex items-center gap-3 text-xl font-extrabold no-underline sm:text-2xl"
            href="/"
        >
            <span class="block size-10 shrink-0 border border-black bg-white sm:size-12" aria-hidden="true"></span>
            <span>Team V.A.N. 12148</span>
        </a>

        <div class="hidden lg:block">
            <Navigation
                client:load
                navlinks={navigationLinks}
                className="flex-none!"
            />
        </div>

        <details class="mobile-menu w-full text-main lg:hidden">
            <summary class="ml-auto flex min-h-11 w-fit cursor-pointer list-none items-center gap-2 rounded-base border-2 border-black px-4 py-2 font-semibold focus-visible:outline-2 focus-visible:outline-offset-4">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path d="M4 6h16M4 12h16M4 18h16" />
                </svg>
                Menu{currentPage ? ` · ${currentPage}` : ""}
            </summary>
            <nav aria-label="Main navigation" class="mt-4 flex flex-col gap-2 border-t border-black/15 pt-4">
                {navigationLinks.map((link) => (
                    <a
                        href={link.href}
                        aria-current={link.active ? "page" : undefined}
                        class:list={[
                            "rounded-base border-2 px-4 py-3 font-semibold focus-visible:outline-2 focus-visible:outline-offset-2",
                            link.active
                                ? "border-black bg-main text-white"
                                : "border-transparent hover:border-black hover:bg-main hover:text-white",
                        ]}
                    >
                        {link.label}
                    </a>
                ))}
            </nav>
        </details>
    </div>
</header>

<style>
    .mobile-menu summary::-webkit-details-marker {
        display: none;
    }
</style>
