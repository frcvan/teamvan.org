---
import { Camera, Mail, Play } from "lucide-react";
---

<footer class="border-silver bg-white text-main mt-12 border-t-2 px-6 py-10 sm:px-10">
    <div class="mx-auto grid w-full max-w-6xl gap-8 sm:grid-cols-2">
        <section>
            <h2 class="mb-3 text-lg">Location</h2>
            <p class="max-w-md text-sm leading-6">
                With our main build space in Palm Bay, we are the only FRC team
                that serves southern Brevard County and northern Indian River
                County.
            </p>
            <address class="mt-3 max-w-md text-sm leading-6 not-italic">
                Eastern Florida State College — Palm Bay Campus
                <br />
                <a
                    class="text-blue-700 underline underline-offset-4 hover:text-blue-900"
                    href="https://www.google.com/maps/search/?api=1&amp;query=Eastern+Florida+State+College+250+Community+College+Pkwy+Palm+Bay+FL+32909"
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label="Open map to Eastern Florida State College Palm Bay campus in a new tab"
                >
                    250 Community College Pkwy, Palm Bay, FL 32909
                </a>
            </address>
        </section>

        <section class="sm:justify-self-end">
            <h2 class="mb-3 text-lg">Connect</h2>
            <address class="flex flex-col gap-2 text-sm not-italic">
                <a
                    class="inline-flex items-center gap-2 underline decoration-silver underline-offset-4 hover:text-black"
                    href="mailto:contact@teamvan.org"
                >
                    <Mail size={16} aria-hidden="true" />
                    contact@teamvan.org
                </a>
                <a
                    class="inline-flex items-center gap-2 underline decoration-silver underline-offset-4 hover:text-black"
                    href="https://www.instagram.com/team.van/"
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label="Instagram profile for Team V.A.N. (opens in a new tab)"
                >
                    <Camera size={16} aria-hidden="true" />
                    @team.van
                </a>
                <a
                    class="inline-flex items-center gap-2 underline decoration-silver underline-offset-4 hover:text-black"
                    href="https://www.youtube.com/@frcvan"
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label="YouTube channel for Team V.A.N. (opens in a new tab)"
                >
                    <Play size={16} aria-hidden="true" />
                    Team V.A.N.
                </a>
                <a
                    class="inline-flex items-center gap-2 underline decoration-silver underline-offset-4 hover:text-black"
                    href="https://github.com/frcvan"
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label="GitHub organization for Team V.A.N. (opens in a new tab)"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="16"
                        height="16"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                        class="shrink-0"
                    >
                        <path d="M9 19c-4.3 1.3-4.3-2.5-6-3m12 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 19 4.77 5.07 5.07 0 0 0 18.91 1S17.73.65 15 2.48a13.38 13.38 0 0 0-7 0C5.27.65 4.09 1 4.09 1A5.07 5.07 0 0 0 4 4.77 5.44 5.44 0 0 0 2.5 8.55c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 8 18.13V22" />
                    </svg>
                    frcvan
                </a>
            </address>
        </section>
    </div>

    <section
        class="mx-auto mt-8 w-full max-w-6xl border-t border-silver pt-8"
        aria-labelledby="sponsor-banners-heading"
    >
        <h2 id="sponsor-banners-heading" class="mb-6 text-lg">
            Want to appear here?{" "}
            <a
                href="/sponsors"
                class="underline decoration-silver underline-offset-4 hover:text-black"
            >
                Sponsor our team!
            </a>
        </h2>
        <div class="flex flex-wrap items-center gap-6">
            <a
                href="https://www.firstinspires.org/"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="FIRST robotics competition website (opens in a new tab)"
                class="flex min-h-32 w-full max-w-sm items-center justify-center rounded-base border border-silver bg-white p-8"
            >
                <img
                    src="/images/sponsors/first-logo.svg"
                    alt="FIRST Robotics Competition logo"
                    class="h-auto w-full max-w-60"
                    loading="lazy"
                />
            </a>
        </div>
    </section>

    <p class="mx-auto mt-8 w-full max-w-6xl border-silver border-t pt-4 text-xs">
        &copy; {new Date().getFullYear()} Team V.A.N. All rights reserved.
    </p>
</footer>
