---
import { Camera, Mail, Play } from "lucide-react";
---

<footer class="border-border bg-white text-main mt-12 border-t-2 px-6 py-10 sm:px-10">
    <div class="mx-auto grid w-full max-w-6xl gap-8 sm:grid-cols-2">
        <section>
            <h2 class="mb-3 text-lg">About Team V.A.N.</h2>
            <p class="max-w-md text-sm leading-6">
                A student-led rookie FIRST Robotics team based in Brevard,
                Florida. We are building robots, skills, and a community
                together.
            </p>
        </section>

        <section class="sm:justify-self-end">
            <h2 class="mb-3 text-lg">Connect</h2>
            <address class="flex flex-col gap-2 text-sm not-italic">
                <a
                    class="inline-flex items-center gap-2 underline underline-offset-4 hover:text-black"
                    href="mailto:contact@teamvan.org"
                >
                    <Mail size={16} aria-hidden="true" />
                    contact@teamvan.org
                </a>
                <a
                    class="inline-flex items-center gap-2 underline underline-offset-4 hover:text-black"
                    href="https://www.instagram.com/team.van/"
                    target="_blank"
                    rel="noreferrer"
                >
                    <Camera size={16} aria-hidden="true" />
                    @team.van
                </a>
                <a
                    class="inline-flex items-center gap-2 underline underline-offset-4 hover:text-black"
                    href="https://www.youtube.com/@frcvan"
                    target="_blank"
                    rel="noreferrer"
                >
                    <Play size={16} aria-hidden="true" />
                    Team V.A.N.
                </a>
            </address>
        </section>
    </div>

    <p class="mx-auto mt-8 w-full max-w-6xl border-border border-t pt-4 text-xs">
        &copy; {new Date().getFullYear()} Team V.A.N. All rights reserved.
    </p>
</footer>
