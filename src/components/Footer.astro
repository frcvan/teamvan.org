---
import copy from "@/content/site/footer.json";
import SocialLink from "@/components/SocialLink.astro";
import SponsorGallery from "@/components/SponsorGallery.astro";

const lastUpdated = new Date().toLocaleString("en-US", {
    year: "numeric",
    month: "numeric",
    day: "numeric",
    hour: "numeric",
    minute: "2-digit",
    timeZoneName: "short",
    timeZone: "America/New_York",
});
---

<footer class="border-silver bg-white text-main mt-12 border-t-2 px-6 py-10 sm:px-10">
    <div class="mx-auto grid w-full max-w-6xl gap-8 sm:grid-cols-2">
        <section id="location">
            <h2 class="mb-3 text-lg"><span class="editor-text">{copy.text001}</span></h2>
            <address class="mt-3 max-w-md text-sm leading-6 not-italic">
                <span class="editor-text">{copy.text002}</span>
                <br />
                <a
                    class="text-blue-700 underline underline-offset-4 hover:text-blue-900"
                    href="https://maps.app.goo.gl/EZpkUnE5RZaprrsCA"
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label="Open map to Mind Forge at 2475 Palm Bay Road, Suite 210, in a new tab"
                >
                    <span class="editor-text">{copy.text003}</span>
                </a>
                <br />
                <span class="editor-text">{copy.text004}</span>
                <br />
                <a
                    class="text-blue-700 underline underline-offset-4 hover:text-blue-900"
                    href="https://maps.app.goo.gl/Rz1pHYC77zdqv4mW6"
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label="Open map to Eastern Florida State College Palm Bay campus in a new tab"
                >
                    <span class="editor-text">{copy.text005}</span>
                </a>
            </address>
        </section>

        <section class="sm:justify-self-end">
            <h2 class="mb-3 text-lg"><span class="editor-text">{copy.text006}</span></h2>
            <address class="flex flex-col gap-2 text-sm not-italic">
                <SocialLink
                    href="mailto:contact@teamvan.org"
                    icon="tabler:mail"
                    label="contact@teamvan.org"
                />
                <SocialLink
                    href="https://www.instagram.com/team.van/"
                    icon="tabler:brand-instagram"
                    label="@team.van"
                    ariaLabel="Instagram profile for Team V.A.N. (opens in a new tab)"
                />
                <SocialLink
                    href="https://www.youtube.com/@frcvan"
                    icon="tabler:brand-youtube"
                    label="Team V.A.N."
                    ariaLabel="YouTube channel for Team V.A.N. (opens in a new tab)"
                />
                <SocialLink
                    href="https://github.com/frcvan"
                    icon="tabler:brand-github"
                    label="frcvan"
                    ariaLabel="GitHub organization for Team V.A.N. (opens in a new tab)"
                />
            </address>
        </section>
    </div>

    <section
        class="mx-auto mt-8 w-full max-w-6xl border-t border-silver pt-8"
        aria-labelledby="sponsor-banners-heading"
    >
        <h2 id="sponsor-banners-heading" class="mb-6 text-lg">
            <span class="editor-text">{copy.text007}</span>{" "}
            <a
                href="/sponsors"
                class="underline decoration-silver underline-offset-4 hover:text-black"
            >
                <span class="editor-text">{copy.text008}</span>
            </a>
        </h2>
        <SponsorGallery />
    </section>

    <div class="mx-auto mt-8 flex w-full max-w-6xl items-center justify-between gap-4 border-silver border-t pt-4 text-xs">
        <p>
            <span class="editor-text">{copy.text009}</span> {new Date().getFullYear()} <span class="editor-text">{copy.text010}</span>
        </p>
        <p>
            <span class="editor-text">{copy.text011}</span> {lastUpdated}
        </p>
    </div>
</footer>
