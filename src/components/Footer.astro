---
import SocialLink from "@/components/SocialLink.astro";
import SponsorGallery from "@/components/SponsorGallery.astro";
import { execFileSync } from "node:child_process";

// Take the date from the last commit that touched the site's inputs instead of
// the clock. Rebuilding the same commit then produces byte-identical HTML, so
// unchanged pages are not re-uploaded on deploy and keep their cached copies.
const siteInputs = [
    "src",
    "public",
    "astro.config.mjs",
    "keystatic.config.ts",
    "wrangler.toml",
    "package.json",
];

const commitDate = (...args: string[]) => {
    try {
        const date = execFileSync(
            "git",
            ["log", "-1", "--format=%cs", ...args],
            { encoding: "utf8" },
        ).trim();
        return date || undefined;
    } catch {
        return undefined;
    }
};

// A shallow clone may not reach the last commit that touched these paths, so
// fall back to HEAD's date before falling back to the clock.
const committedOn = commitDate("--", ...siteInputs) ?? commitDate();

// Noon UTC keeps the calendar date stable when formatted in New York.
const updatedOn = committedOn
    ? new Date(`${committedOn}T12:00:00Z`)
    : new Date();

const lastUpdated = updatedOn.toLocaleDateString("en-US", {
    year: "numeric",
    month: "numeric",
    day: "numeric",
    timeZone: "America/New_York",
});

const copyrightYear = updatedOn.toLocaleDateString("en-US", {
    year: "numeric",
    timeZone: "UTC",
});
---

<footer class="border-rule bg-secondary-background text-main mt-12 border-t-4 px-6 py-10 sm:px-10">
    <div class="mx-auto grid w-full max-w-6xl gap-8 sm:grid-cols-2">
        <section id="location">
            <h2 class="mb-3 text-2xl">Location</h2>
            <address class="mt-3 max-w-md text-sm leading-6 not-italic">
                The MindForge Guild
                <br />
                <a
                    class="link-bar font-bold text-link"
                    href="https://maps.app.goo.gl/EZpkUnE5RZaprrsCA"
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label="Open map to The MindForge at 2475 Palm Bay Road, Suite 210, in a new tab"
                >
                    2475 Palm Bay Rd, Suite 210
                </a>
            </address>
        </section>

        <section class="sm:justify-self-end">
            <h2 class="mb-3 text-2xl">Connect</h2>
            <address class="grid gap-2 text-sm not-italic md:grid-cols-2 md:gap-x-10">
                <SocialLink
                    href="mailto:contact@teamvan.org"
                    icon="tabler:mail"
                    label="contact@teamvan.org"
                />
                <SocialLink
                    href="https://www.instagram.com/team.van/"
                    icon="tabler:brand-instagram"
                    label="@team.van"
                    ariaLabel="Instagram profile for Team V.A.N. (opens in a new tab)"
                />
                <SocialLink
                    href="https://www.youtube.com/@frcvan"
                    icon="tabler:brand-youtube"
                    label="Team V.A.N."
                    ariaLabel="YouTube channel for Team V.A.N. (opens in a new tab)"
                />
                <SocialLink
                    href="https://github.com/frcvan"
                    icon="tabler:brand-github"
                    label="frcvan"
                    ariaLabel="GitHub organization for Team V.A.N. (opens in a new tab)"
                />
            </address>
        </section>
    </div>

    <section
        class="mx-auto mt-8 w-full max-w-6xl border-t-2 border-rule pt-8"
        aria-labelledby="sponsor-banners-heading"
    >
        <h2 id="sponsor-banners-heading" class="mb-6 text-2xl">
            Want to Appear Here?{" "}
            <a href="/sponsors" class="link-bar font-bold text-link">
                Sponsor Our Team!
            </a>
        </h2>
        <SponsorGallery />
    </section>

    <div class="mx-auto mt-8 flex w-full max-w-6xl items-center justify-between gap-4 border-t-2 border-rule pt-4 text-xs">
        <p>&copy; {copyrightYear} Team V.A.N. All rights reserved.</p>
        <span class="hidden -rotate-2 border-2 border-rule bg-gold px-2 py-1 text-[0.6rem] font-bold tracking-[0.16em] text-ink uppercase sm:inline-block">
            Est. 2026
        </span>
        <p>Website last updated: {lastUpdated}</p>
    </div>
</footer>
