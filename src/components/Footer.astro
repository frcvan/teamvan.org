---
import { Camera, Mail, Play } from "lucide-react";
---

<footer class="border-border bg-white text-main mt-12 border-t-2 px-6 py-10 sm:px-10">
    <div class="mx-auto grid w-full max-w-6xl gap-8 sm:grid-cols-2">
        <section>
            <h2 class="mb-3 text-lg">About Team V.A.N.</h2>
            <p class="max-w-md text-sm leading-6">
                A student-led rookie FIRST Robotics team based in Brevard,
                Florida.<br />
                With main build space in Palm Bay, we serve southern Brevard County
                and northern Indian River County.
            </p>
            <address class="mt-3 max-w-md text-sm leading-6 not-italic">
                Eastern Florida State College — Palm Bay Campus<br />
                <a
                    class="text-blue-700 underline underline-offset-4 hover:text-blue-900"
                    href="https://www.google.com/maps/search/?api=1&amp;query=Eastern+Florida+State+College+250+Community+College+Pkwy+Palm+Bay+FL+32909"
                    target="_blank"
                    rel="noreferrer"
                >
                    250 Community College Pkwy, Palm Bay, FL 32909
                </a>
            </address>
        </section>

        <section class="sm:justify-self-end">
            <h2 class="mb-3 text-lg">Connect</h2>
            <address class="flex flex-col gap-2 text-sm not-italic">
                <a
                    class="inline-flex items-center gap-2 underline underline-offset-4 hover:text-black"
                    href="mailto:contact@teamvan.org"
                >
                    <Mail size={16} aria-hidden="true" />
                    contact@teamvan.org
                </a>
                <a
                    class="inline-flex items-center gap-2 underline underline-offset-4 hover:text-black"
                    href="https://www.instagram.com/team.van/"
                    target="_blank"
                    rel="noreferrer"
                >
                    <Camera size={16} aria-hidden="true" />
                    @team.van
                </a>
                <a
                    class="inline-flex items-center gap-2 underline underline-offset-4 hover:text-black"
                    href="https://www.youtube.com/@frcvan"
                    target="_blank"
                    rel="noreferrer"
                >
                    <Play size={16} aria-hidden="true" />
                    Team V.A.N.
                </a>
                <a
                    class="inline-flex items-center gap-2 underline underline-offset-4 hover:text-black"
                    href="https://github.com/frcvan"
                    target="_blank"
                    rel="noreferrer"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="16"
                        height="16"
                        viewBox="0 0 16 16"
                        fill="currentColor"
                        aria-hidden="true"
                        class="shrink-0"
                    >
                        <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.65 7.65 0 0 1 2-.27c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8Z" />
                    </svg>
                    GitHub: frcvan
                </a>
            </address>
        </section>
    </div>

    <p class="mx-auto mt-8 w-full max-w-6xl border-border border-t pt-4 text-xs">
        &copy; {new Date().getFullYear()} Team V.A.N. All rights reserved.
    </p>
</footer>
