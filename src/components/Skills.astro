---
import "@/styles/motion.css";

interface Props {
    title?: string;
}

const { title = "Pick a department" } = Astro.props as Props;

const roles = [
    { name: "Partnerships", detail: "Sponsors and community partners" },
    { name: "Finance", detail: "Budget, purchases, and records" },
    { name: "Media", detail: "Photos, video, and social posts" },
    { name: "Operations", detail: "Schedule, travel, and event logistics" },
    { name: "Speaking", detail: "Judging, presentations, and outreach" },
    { name: "Build", detail: "Mechanical, electrical, and controls work" },
];
---

<div class="visual-rise border-4 border-rule bg-secondary-background shadow-[8px_8px_0_var(--rule)]">
    <p class="border-b-4 border-rule px-4 py-2 text-[0.65rem] font-bold tracking-[0.18em] text-link uppercase">
        {title}
    </p>
    <dl class="visual-rise-stagger grid sm:grid-cols-2">
        {roles.map(({ name, detail }, index) => (
            <div
                class:list={[
                    "flex flex-wrap items-baseline gap-x-3 gap-y-1 px-4 py-3",
                    index > 0 && "border-t-4 border-rule",
                    index % 2 === 1 && "sm:border-l-4",
                    index === 1 && "sm:border-t-0",
                ]}
            >
                <dt class="font-heading text-xl leading-none font-extrabold uppercase">
                    {name}
                </dt>
                <dd class="text-sm">{detail}</dd>
            </div>
        ))}
    </dl>
</div>
