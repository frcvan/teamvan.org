---
interface Props {
    value: string;
    label: string;
}

const { value, label } = Astro.props as Props;
---

<div class="rounded-base border border-white/20 bg-white/5 p-4 text-center">
    <div class="text-3xl font-extrabold leading-tight">{value}</div>
    <div class="mt-1 text-sm">{label}</div>
</div>
