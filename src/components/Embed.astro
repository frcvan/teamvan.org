---
import Loader from "./Loader.astro";

interface Props {
    src: string;
    variant?: "calendar" | "form";
}

const { src, variant = "calendar" } = Astro.props as Props;

// The editor writes the frame's name as the embed's text so it reads like a
// caption. Astro can only hand the iframe a string, so the slot is rendered
// once and stripped of its markup.
const slotText = Astro.slots.has("default")
    ? await Astro.slots.render("default")
    : "";
const title = slotText
    .replace(/<[^>]*>/g, " ")
    .replace(/\s+/g, " ")
    .trim();
const containerClass =
    variant === "calendar"
        ? "w-full overflow-hidden rounded-base border-4 border-rule bg-cream shadow-[6px_6px_0_var(--rule)]"
        : "w-full h-[800px] overflow-hidden rounded-base border-none shadow-none";
const frameClass =
    variant === "calendar"
        ? "h-150 w-full border-0 max-[600px]:h-[70vh]"
        : "w-full h-full border-none outline-none shadow-none";
---

<div class:list={["relative", containerClass]} data-embed-container>
    <div
        class="absolute inset-0 z-10 flex items-center justify-center transition-opacity duration-300 in-[.is-loaded]:pointer-events-none in-[.is-loaded]:opacity-0"
        data-embed-loader
        role="status"
        aria-label="Loading content"
    >
        <Loader />
    </div>
    <iframe
        class:list={[
            "block opacity-0 transition-opacity duration-300 in-[.is-loaded]:opacity-100",
            frameClass,
        ]}
        src={src}
        title={title || "Embedded content"}
        loading="eager"
        data-embed
    ></iframe>
</div>

<script>
    document
        .querySelectorAll<HTMLElement>("[data-embed-container]")
        .forEach((container) => {
            const iframe =
                container.querySelector<HTMLIFrameElement>("[data-embed]");

            iframe?.addEventListener(
                "load",
                () => container.classList.add("is-loaded"),
                { once: true },
            );
        });
</script>
