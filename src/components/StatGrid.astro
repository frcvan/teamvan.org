---
interface Stat {
    value: string;
    label: string;
}

interface Props {
    stats: Stat[];
}

const { stats } = Astro.props as Props;
---

<div class="grid grid-cols-2 gap-4 sm:grid-cols-4">
    {stats.map((stat) => (
        <div class="rounded-base border border-white/20 bg-white/5 p-4 text-center">
            <div class="text-3xl font-extrabold leading-tight">{stat.value}</div>
            <div class="mt-1 text-sm">{stat.label}</div>
        </div>
    ))}
</div>
