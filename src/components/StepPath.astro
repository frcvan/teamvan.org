---
import "@/styles/motion.css";

interface Props {
    title?: string;
}

const { title } = Astro.props as Props;
---

<figure class="visual-rise border-4 border-rule bg-secondary-background shadow-[8px_8px_0_var(--rule)]">
    {title && (
        <figcaption class="border-b-4 border-rule px-4 py-2 text-[0.65rem] font-bold tracking-[0.18em] text-link uppercase">
            {title}
        </figcaption>
    )}
    <ol class="step-path m-0 grid list-none grid-cols-1 p-0 sm:auto-cols-fr sm:grid-flow-col">
        <slot />
    </ol>
</figure>

<style is:global>
    .step-path {
        counter-reset: step;
    }

    .step-path li {
        counter-increment: step;
    }

    .step-path li::before {
        content: counter(step, decimal-leading-zero);
        display: inline-block;
        margin-bottom: 0.5rem;
        border: 2px solid var(--rule);
        background: var(--brand);
        padding: 0.05rem 0.35rem;
        color: var(--cream);
        font-size: 0.65rem;
        font-weight: 800;
        letter-spacing: 0.08em;
        line-height: 1.1;
    }
</style>
