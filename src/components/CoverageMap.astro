---
import {
    coverageCounties,
    coverageViewBox,
    projectPoint,
} from "@/data/coverage-geo";

// Option 2: the two counties drawn from Census outlines. The frame is cropped
// to the area the team serves, so Brevard runs off the top edge on purpose.
const [baseX, baseY] = projectPoint(-80.6315695, 28.0352612);
const svgHeight = Number(coverageViewBox.split(" ")[3]);
const [brevardX, brevardY] = projectPoint(-80.7, 27.9);
const [indianRiverX, indianRiverY] = projectPoint(-80.5, 27.7);
---

<figure class="border-4 border-rule bg-secondary-background shadow-[8px_8px_0_var(--rule)]">
    <figcaption class="flex flex-wrap items-baseline justify-between gap-2 border-b-4 border-rule px-4 py-2">
        <span class="text-[0.65rem] font-bold tracking-[0.18em] text-link uppercase">
            Area we cover
        </span>
        <span class="text-[0.65rem] font-bold tracking-[0.18em] uppercase opacity-70">
            Southern Brevard + Indian River
        </span>
    </figcaption>
    <div class="grid gap-5 p-4 sm:grid-cols-[1fr_19rem] sm:items-start">
        <div class="order-2 sm:order-1">
            <dl class="grid gap-4">
                <div>
                    <dt class="text-[0.65rem] font-bold tracking-[0.18em] uppercase opacity-70">
                        Brevard County
                    </dt>
                    <dd class="font-heading text-2xl leading-tight font-extrabold uppercase">
                        1 FRC team, ours
                    </dd>
                </div>
                <div>
                    <dt class="text-[0.65rem] font-bold tracking-[0.18em] uppercase opacity-70">
                        Indian River County
                    </dt>
                    <dd class="font-heading text-2xl leading-tight font-extrabold uppercase">
                        0 FRC teams
                    </dd>
                </div>
                <div>
                    <dt class="text-[0.65rem] font-bold tracking-[0.18em] uppercase opacity-70">
                        Nearest team outside the area
                    </dt>
                    <dd class="font-heading text-2xl leading-tight font-extrabold uppercase">
                        40+ min drive
                    </dd>
                </div>
            </dl>
            <p class="mt-4 flex items-center gap-2 text-xs">
                <span
                    aria-hidden="true"
                    class="inline-block size-3 border-2 border-rule bg-gold"
                ></span>
                Team V.A.N. build space at The MindForge Guild
            </p>
        </div>
        <svg
            viewBox={coverageViewBox}
            width="1000"
            height={svgHeight}
            class="order-1 h-auto w-full max-w-[19rem] justify-self-center border-2 border-rule bg-paper sm:order-2"
            role="img"
            aria-label="Map of southern Brevard County and Indian River County in Florida, with the team's build space marked in Palm Bay"
        >
            {coverageCounties.map((county) => (
                <path
                    d={county.path}
                    class:list={[
                        "stroke-[2]",
                        county.focus
                            ? "fill-brand/25 stroke-rule"
                            : "fill-paper stroke-rule/25",
                    ]}
                    vector-effect="non-scaling-stroke"
                />
            ))}
            <circle
                cx={baseX}
                cy={baseY}
                r="11"
                class="fill-gold stroke-rule"
                stroke-width="4"
                vector-effect="non-scaling-stroke"
            ></circle>
            <text
                x={baseX + 20}
                y={baseY + 11}
                font-size="30"
                class="fill-main font-heading font-bold uppercase"
            >
                Team V.A.N.
            </text>
            <text
                x={brevardX}
                y={brevardY}
                text-anchor="middle"
                font-size="52"
                letter-spacing="2"
                class="fill-main font-heading font-bold uppercase"
            >
                Brevard
            </text>
            <text
                x={indianRiverX}
                y={indianRiverY}
                text-anchor="middle"
                font-size="42"
                letter-spacing="1"
                class="fill-main font-heading font-bold uppercase"
            >
                <tspan x={indianRiverX} dy="0">
                    Indian
                </tspan>
                <tspan x={indianRiverX} dy="40">
                    River
                </tspan>
            </text>
        </svg>
    </div>
</figure>
