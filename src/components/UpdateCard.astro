---
import { formatUpdateDateParts, type Update } from "@/data/updates";

interface Props {
    update: Update;
}

const { update } = Astro.props as Props;
const { month, day, year } = formatUpdateDateParts(update.date);
---

<a
    href={`/updates/${update.slug}/`}
    class="group grid overflow-hidden border-4 border-rule bg-secondary-background text-main no-underline shadow-[6px_6px_0_var(--rule)] transition-[transform,box-shadow] duration-200 hover:-translate-y-1 hover:shadow-[10px_10px_0_var(--gold)] sm:grid-cols-[8rem_1fr]"
>
    <div class="flex items-center justify-between gap-3 border-b-4 border-rule bg-brand px-4 py-3 text-cream sm:flex-col sm:items-start sm:justify-between sm:border-r-4 sm:border-b-0">
        <time datetime={update.date} class="block">
            <span class="block font-heading text-4xl leading-none font-extrabold tracking-tight">
                {day}
            </span>
            <span class="mt-1 block text-[0.65rem] font-bold tracking-[0.18em] uppercase">
                {month} {year}
            </span>
        </time>
        <span class="border-2 border-ink bg-gold px-2 py-1 text-[0.55rem] font-bold tracking-[0.18em] text-ink uppercase shadow-[2px_2px_0_var(--ink)]">
            Update
        </span>
    </div>
    <div class="p-4 sm:p-5">
        <p class="font-heading text-2xl leading-tight font-extrabold uppercase sm:text-3xl">
            {update.title}
        </p>
        <p class="mt-2 text-sm">{update.summary}</p>
        <span class="mt-4 inline-flex items-center gap-2 text-[0.65rem] font-bold tracking-[0.18em] text-link uppercase">
            Read update
            <span
                aria-hidden="true"
                class="grid size-5 place-items-center border-2 border-rule bg-gold text-[0.7rem] leading-none font-bold text-ink shadow-[2px_2px_0_var(--rule)] transition-transform duration-200 group-hover:translate-x-1"
            >
                →
            </span>
        </span>
    </div>
</a>
