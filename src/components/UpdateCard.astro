---
import { formatUpdateDate, type Update } from "@/data/updates";

interface Props {
    update: Update;
}

const { update } = Astro.props as Props;
---

<a
    href={`/updates/${update.slug}/`}
    class="group block border-4 border-rule bg-secondary-background p-5 text-main no-underline shadow-[6px_6px_0_var(--rule)] transition-[transform,box-shadow] duration-200 hover:-translate-y-1 hover:shadow-[10px_10px_0_var(--link)]"
>
    <time
        datetime={update.date}
        class="inline-block border-2 border-rule bg-brand px-2 py-1 text-[0.65rem] font-bold tracking-[0.18em] text-cream uppercase"
    >
        {formatUpdateDate(update.date)}
    </time>
    <p class="mt-3 font-heading text-2xl leading-tight font-extrabold uppercase sm:text-3xl">
        {update.title}
    </p>
    <p class="mt-2 text-sm">{update.summary}</p>
    <span class="mt-4 inline-flex items-center gap-2 text-[0.65rem] font-bold tracking-[0.18em] text-link uppercase">
        Read update
        <span
            aria-hidden="true"
            class="transition-transform duration-200 group-hover:translate-x-1"
        >
            →
        </span>
    </span>
</a>
