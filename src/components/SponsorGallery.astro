---
import { Image } from "astro:assets";

import { sponsors } from "@/data/sponsors";

const logoClass =
    "h-full w-full object-contain transition-transform duration-200 group-hover:scale-[1.04] group-hover:-rotate-1 motion-reduce:transition-none";
---

<ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {sponsors.map(({ name, href, logo }) => (
        <li>
            <a
                href={href}
                target="_blank"
                aria-label={`${name} (opens in a new tab)`}
                class="group relative flex h-28 w-full items-center justify-center overflow-hidden rounded-base border-4 border-rule bg-cream p-3 shadow-[6px_6px_0_var(--rule)] transition-[translate,box-shadow] duration-150 hover:-translate-y-0.5 hover:shadow-[8px_8px_0_var(--rule)] focus-visible:-translate-y-0.5 focus-visible:shadow-[8px_8px_0_var(--rule)]"
            >
                {"asset" in logo ? (
                    <Image
                        src={logo.asset}
                        alt=""
                        loading="lazy"
                        class={logoClass}
                    />
                ) : (
                    <img
                        src={logo.url}
                        width={logo.width}
                        height={logo.height}
                        alt=""
                        loading="lazy"
                        decoding="async"
                        referrerpolicy="no-referrer"
                        class={logoClass}
                    />
                )}
                <span
                    aria-hidden="true"
                    class="pointer-events-none absolute inset-x-0 bottom-0 translate-y-full border-t-2 border-rule bg-brand px-2 py-1 text-[0.65rem] font-bold tracking-[0.12em] text-cream uppercase transition-transform duration-200 group-hover:translate-y-0 group-focus-visible:translate-y-0"
                >
                    {name}
                </span>
            </a>
        </li>
    ))}
</ul>
