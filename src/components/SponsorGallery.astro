---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

import firstLogo from "@/images/sponsors/first-logo.svg";
import argosyFoundationLogo from "@/images/sponsors/argosy-foundation-logo.png";
import hcbLogo from "@/images/sponsors/hcb-logo.png";

type Logo =
    { asset: ImageMetadata } | { url: string; width: number; height: number };

interface Sponsor {
    name: string;
    href: string;
    logo: Logo;
}

const sponsors: Sponsor[] = [
    {
        name: "FIRST Robotics Competition",
        href: "https://www.firstinspires.org/",
        logo: { asset: firstLogo },
    },
    {
        name: "Argosy Foundation",
        href: "https://www.argosyfnd.org/",
        logo: { asset: argosyFoundationLogo },
    },
    {
        name: "Hack Club Bank",
        href: "https://hackclub.com/hcb",
        logo: { asset: hcbLogo },
    },
    {
        name: "RMFG",
        href: "https://www.rmfg.com",
        // Hotlinked because we have no local copy of their logo; the intrinsic
        // size keeps the card from shifting while the image loads.
        logo: {
            url: "https://www.rmfg.com/RMFG-V2-Wordmark-Green-On-Black.png",
            width: 1337,
            height: 467,
        },
    },
];

const logoClass =
    "max-h-16 w-auto max-w-full object-contain transition-transform duration-200 group-hover:scale-[1.04] group-hover:-rotate-1 motion-reduce:transition-none";
---

<ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {sponsors.map(({ name, href, logo }) => (
        <li>
            <a
                href={href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`${name} (opens in a new tab)`}
                class="group relative flex min-h-28 w-full items-center justify-center overflow-hidden rounded-base border-4 border-rule bg-cream p-3 shadow-[6px_6px_0_var(--rule)] transition-[translate,box-shadow] duration-150 hover:-translate-y-0.5 hover:shadow-[8px_8px_0_var(--rule)] focus-visible:-translate-y-0.5 focus-visible:shadow-[8px_8px_0_var(--rule)]"
            >
                {"asset" in logo ? (
                    <Image
                        src={logo.asset}
                        alt=""
                        loading="lazy"
                        class={logoClass}
                    />
                ) : (
                    <img
                        src={logo.url}
                        width={logo.width}
                        height={logo.height}
                        alt=""
                        loading="lazy"
                        decoding="async"
                        referrerpolicy="no-referrer"
                        class={logoClass}
                    />
                )}
                <span
                    aria-hidden="true"
                    class="pointer-events-none absolute inset-x-0 bottom-0 translate-y-full border-t-2 border-rule bg-gold px-2 py-1 text-[0.65rem] font-bold tracking-[0.12em] text-ink uppercase transition-transform duration-200 group-hover:translate-y-0 group-focus-visible:translate-y-0"
                >
                    {name}
                </span>
            </a>
        </li>
    ))}
</ul>
