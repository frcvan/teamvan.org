---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
    src?: string | null;
    alt: string;
    credit?: string;
    creditHref?: string;
    variant?: "natural" | "wide" | "bleed";
}

const {
    src,
    alt,
    credit,
    creditHref,
    variant = "natural",
} = Astro.props as Props;
const hasCaption = Astro.slots.has("default");
const hasFooter = hasCaption || Boolean(credit);

// Keystatic stores content-component images under src/ with a /src/ public
// path. Resolve that path to image metadata so <Image> can optimize it.
const pageImages = import.meta.glob<{ default: ImageMetadata }>(
    "/src/images/pages/*.{jpeg,jpg,png,webp,avif}",
);
const loadImage = src ? pageImages[src] : undefined;
const image = loadImage ? (await loadImage()).default : undefined;

const isBleed = variant === "bleed";

const imageClass = [
    "h-auto w-full object-cover",
    variant === "wide" && "aspect-[25/12] object-bottom",
    hasFooter && "border-b-4 border-rule",
]
    .filter(Boolean)
    .join(" ");
---

{src && (
    <figure
        data-bleed={isBleed ? "" : undefined}
        class:list={[
            isBleed ? "my-10" : "my-6",
            // Full width breaks out of the text column to the viewport edges.
            isBleed
                ? "mx-[calc(50%_-_50vw)] border-y-4 border-rule"
                : "rounded-base border-4 border-rule shadow-[6px_6px_0_var(--rule)]",
            // The caption lives in a strip inside the frame, so the figure
            // reads as a panel rather than a photo with loose text under it.
            "overflow-hidden bg-secondary-background",
            variant === "wide" && "lg:-mx-6",
        ]}
    >
        {image ? (
            <Image
                src={image}
                alt={alt}
                loading="lazy"
                class={imageClass}
                widths={isBleed ? [640, 960, 1280, 1600, 2000] : undefined}
                sizes={isBleed ? "100vw" : undefined}
            />
        ) : (
            <img src={src} alt={alt} loading="lazy" class={imageClass} />
        )}
        {hasFooter && (
            <figcaption
                class:list={[
                    "flex items-baseline gap-2 py-3 text-sm",
                    isBleed
                        ? "mx-auto max-w-5xl px-6 sm:px-10 lg:px-12"
                        : "px-4 sm:px-5",
                ]}
            >
                <span
                    aria-hidden="true"
                    class="font-heading text-lg leading-none text-link"
                >
                    //
                </span>
                <div>
                    <slot />
                    {credit && (
                        <span class="mt-1 block text-xs opacity-70">
                            Photo:{" "}
                            {creditHref ? (
                                <a
                                    href={creditHref}
                                    class="underline"
                                    rel="noopener noreferrer"
                                    target="_blank"
                                >
                                    {credit}
                                </a>
                            ) : (
                                credit
                            )}
                        </span>
                    )}
                </div>
            </figcaption>
        )}
    </figure>
)}
