---
interface Props {
    href?: string;
    variant?: "primary" | "secondary" | "ghost" | "outline";
    size?: "default" | "sm" | "lg" | "icon";
    class?: string;
    download?: string | boolean;
    target?: string;
    rel?: string;
    ariaLabel?: string;
    current?: boolean;
}

const {
    href,
    variant = "primary",
    size = "default",
    class: className,
    download,
    target,
    rel,
    ariaLabel,
    current = false,
} = Astro.props;

const classes = [
    "btn !px-4 text-base font-bold !min-h-11",
    size === "lg" && "!px-5 text-[1.05rem] !min-h-13",
    className,
];
---

{href ? (
    <a
        href={href}
        class:list={classes}
        data-variant={variant}
        data-size={size === "default" ? undefined : size}
        aria-current={current ? "page" : undefined}
        download={download}
        target={target}
        rel={rel}
        aria-label={ariaLabel}
    >
        <slot />
    </a>
) : (
    <button
        type="button"
        class:list={classes}
        data-variant={variant}
        data-size={size === "default" ? undefined : size}
        aria-current={current ? "page" : undefined}
        aria-label={ariaLabel}
    >
        <slot />
    </button>
)}
