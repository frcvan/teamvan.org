---
interface Props {
    href?: string;
    variant?: "primary" | "secondary" | "accent" | "ghost" | "outline";
    size?: "default" | "sm" | "lg" | "icon";
    class?: string;
    download?: string | boolean;
    target?: string;
    rel?: string;
    ariaLabel?: string;
    current?: boolean;
    outline?: boolean;
    disabled?: boolean;
}

const {
    href,
    variant = "primary",
    size = "default",
    class: className,
    download,
    target,
    rel,
    ariaLabel,
    current = false,
    outline = true,
    disabled = false,
} = Astro.props as Props;

const variantClasses = {
    primary: "bg-brand text-white hover:bg-brand-hover",
    secondary: "bg-secondary-background text-main hover:bg-gold hover:text-ink",
    accent: "bg-accent text-accent-foreground hover:bg-accent-hover",
    ghost: "text-main hover:bg-main hover:text-secondary-background",
    outline:
        "border-2 border-rule text-main hover:bg-main hover:text-secondary-background",
};

const sizeClasses = {
    default: "min-h-11 px-4 text-base",
    sm: "min-h-9 px-3 text-sm",
    lg: "min-h-13 px-5 text-[1.05rem]",
    icon: "size-11 p-0",
};

const classes = [
    "inline-flex shrink-0 cursor-pointer select-none items-center justify-center gap-1.5 rounded-base text-center font-bold whitespace-nowrap transition-[color,background-color,border-color,translate,box-shadow] duration-150 ease-out hover:-translate-y-0.5 focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-main/60 [&_p]:m-0 [&_svg]:pointer-events-none [&_svg]:shrink-0",
    sizeClasses[size],
    variantClasses[variant],
    outline && variant !== "outline" && "border-2 border-rule",
    outline
        ? "shadow-[3px_3px_0_var(--btn-shadow,var(--rule))] hover:shadow-[5px_5px_0_var(--btn-shadow,var(--rule))] active:translate-x-[3px] active:translate-y-[3px] active:shadow-none"
        : "active:translate-y-0.5",
    disabled && "pointer-events-none cursor-not-allowed opacity-50",
    className,
];
---

{href ? (
    <a
        href={disabled ? undefined : href}
        class:list={classes}
        aria-current={current ? "page" : undefined}
        aria-disabled={disabled ? "true" : undefined}
        tabindex={disabled ? -1 : undefined}
        download={download}
        target={target}
        rel={rel}
        aria-label={ariaLabel}
    >
        <slot />
    </a>
) : (
    <button
        type="button"
        class:list={classes}
        aria-current={current ? "page" : undefined}
        aria-label={ariaLabel}
        disabled={disabled}
    >
        <slot />
    </button>
)}
