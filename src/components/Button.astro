---
interface Props {
    href?: string;
    variant?: "primary" | "secondary" | "ghost" | "outline";
    size?: "default" | "sm" | "lg" | "icon";
    class?: string;
    download?: string | boolean;
    target?: string;
    rel?: string;
    ariaLabel?: string;
    current?: boolean;
    disabled?: boolean;
}

const {
    href,
    variant = "primary",
    size = "default",
    class: className,
    download,
    target,
    rel,
    ariaLabel,
    current = false,
    disabled = false,
} = Astro.props as Props;

const variantClasses = {
    primary: "bg-brand text-white hover:bg-brand/85",
    secondary:
        "bg-secondary-background text-main hover:bg-secondary-background/90",
    ghost: "text-main hover:bg-main hover:text-secondary-background",
    outline:
        "border border-main text-main hover:bg-main hover:text-secondary-background",
};

const sizeClasses = {
    default: "min-h-11 px-4 text-base",
    sm: "min-h-9 px-3 text-sm",
    lg: "min-h-13 px-5 text-[1.05rem]",
    icon: "size-11 p-0",
};

const classes = [
    "inline-flex shrink-0 cursor-pointer select-none items-center justify-center gap-1.5 rounded-base text-center font-bold whitespace-nowrap transition-all outline-none focus-visible:ring-3 focus-visible:ring-main/50 active:translate-y-px [&_p]:m-0 [&_svg]:pointer-events-none [&_svg]:shrink-0",
    sizeClasses[size],
    variantClasses[variant],
    disabled && "pointer-events-none cursor-not-allowed opacity-50",
    className,
];
---

{href ? (
    <a
        href={disabled ? undefined : href}
        class:list={classes}
        aria-current={current ? "page" : undefined}
        aria-disabled={disabled ? "true" : undefined}
        tabindex={disabled ? -1 : undefined}
        download={download}
        target={target}
        rel={rel}
        aria-label={ariaLabel}
    >
        <slot />
    </a>
) : (
    <button
        type="button"
        class:list={classes}
        aria-current={current ? "page" : undefined}
        aria-label={ariaLabel}
        disabled={disabled}
    >
        <slot />
    </button>
)}
