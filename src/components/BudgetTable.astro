---
interface Props {
    total: string;
}

const { total } = Astro.props as Props;
---

<div class="overflow-x-auto rounded-base border-4 border-rule shadow-[6px_6px_0_var(--rule)]">
    <table class="w-full min-w-max border-collapse text-sm">
        <thead>
            <tr class="bg-brand text-accent-foreground">
                <th class="border-b-4 border-rule py-2.5 pr-4 pl-4 text-left font-heading text-base tracking-wide">
                    Budget item
                </th>
                <th class="border-b-4 border-rule py-2.5 pr-4 text-right font-heading text-base tracking-wide">
                    Cost
                </th>
            </tr>
        </thead>
        <tbody>
            <slot />
        </tbody>
        <tfoot>
            <tr class="border-t-2 border-main/50 font-bold">
                <td class="py-2 pr-4 pl-4">Total</td>
                <td class="py-2 pr-4 text-right tabular-nums">{total}</td>
            </tr>
        </tfoot>
    </table>
</div>
