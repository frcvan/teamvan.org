---
import Button from "@/components/Button.astro";
import { sponsors } from "@/data/sponsors";
import VanLogo from "@/images/van-logo.svg";
---

<section class="relative isolate w-full overflow-hidden">
    <img
        src="/images/pages/hero-frc.jpg"
        alt="FRC robots 180, 179, and 1902 line up on the field beneath hanging game pieces while drive teams and spectators watch from the stands"
        width="2000"
        height="1333"
        fetchpriority="high"
        class="hero-media h-[clamp(26rem,50vw,34rem)] w-full object-cover object-center"
    />
    <div class="lg:absolute lg:inset-0">
        <div class="flex max-w-5xl items-end px-6 py-6 sm:px-10 sm:py-8 lg:h-full lg:px-12">
            <div class="hero-rise w-full max-w-2xl border-4 border-ink bg-paper p-5 shadow-[10px_10px_0_var(--link)] sm:p-7">
                <p class="inline-block border-2 border-ink bg-brand px-2 py-1 text-[0.65rem] font-bold tracking-[0.18em] text-cream uppercase">
                    FRC 12148 · Palm Bay, Florida
                </p>
                <p class="hero-logo mt-5 flex items-baseline text-[clamp(2.25rem,6vw,3.75rem)] leading-none whitespace-nowrap text-ink">
                    <span class="sr-only">Team V.A.N.</span>
                    <span aria-hidden="true" class="inline-flex items-baseline">
                        <span>Team</span>
                        <span class="ml-2 inline-flex items-baseline">
                            <VanLogo
                                width="1280"
                                height="448"
                                class="block size-[0.74em] shrink-0 fill-ink!"
                            />
                            <span class="-ml-[0.11em]">.A.N.</span>
                        </span>
                    </span>
                </p>
                <p class="mt-3 max-w-xl text-base text-ink">
                    A student-managed rookie FIRST Robotics Competition team
                    serving southern Brevard and Indian River counties.
                </p>
                <div class="mt-4 flex flex-wrap gap-3">
                    <Button href="/interest/" variant="accent">
                        Join the team
                    </Button>
                    <Button href="/sponsors/" variant="secondary">
                        Sponsor us
                    </Button>
                </div>
            </div>
        </div>
    </div>
</section>

<aside class="sponsor-ticker" aria-label="Our sponsors">
    <p class="sponsor-ticker-label">Powered By</p>
    <div class="sponsor-ticker-window">
        <div class="sponsor-ticker-track">
            {[0, 1].map((copy) => (
                <div
                    class="sponsor-ticker-group"
                    aria-hidden={copy === 1 ? "true" : undefined}
                >
                    {sponsors.map(({ name }) => (
                        <span class="sponsor-ticker-item">
                            <span
                                class="sponsor-ticker-flag"
                                aria-hidden="true"
                            ></span>
                            <span
                                class="sponsor-ticker-slash"
                                aria-hidden="true"
                            >
                                //
                            </span>
                            <span class="sponsor-ticker-name">{name}</span>
                        </span>
                    ))}
                </div>
            ))}
        </div>
    </div>
</aside>
