---
interface Phase {
    period: string;
    title: string;
    description: string;
}

interface Props {
    phases: Phase[];
}

const { phases } = Astro.props as Props;
---

<ol class="relative space-y-6 border-l-2 border-white/30 pl-6">
    {phases.map((phase) => (
        <li class="relative">
            <span class="absolute top-1 -left-7.25 size-3 rounded-full border-2 border-white bg-main"></span>
            <div class="text-xs font-bold tracking-wide uppercase opacity-80">
                {phase.period}
            </div>
            <div class="mt-0.5 text-lg font-bold">{phase.title}</div>
            <p class="mt-1">{phase.description}</p>
        </li>
    ))}
</ol>
