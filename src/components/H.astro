---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"h1" | "h2" | "h3" | "h4"> {
    level?: "h1" | "h2" | "h3" | "h4";
    description?: string;
    class?: string;
}

const { level = "h1", description, class: className, ...props } = Astro.props;

const Tag = level;
const headerSizes = {
    h1: "text-4xl leading-tight lg:text-5xl",
    h2: "text-3xl leading-tight",
    h3: "text-2xl leading-tight",
    h4: "text-xl leading-tight",
};
---

<div class:list={["space-y-1.5", level === "h2" && "border-b pb-4", className]}>
    <Tag class:list={["scroll-m-20 font-bold", headerSizes[level]]} {...props}>
        <slot />
    </Tag>

    {description && (
        <p
            class:list={[
                "text-slate-600",
                level === "h1" ? "text-lg" : "text-sm",
            ]}
        >
            {description}
        </p>
    )}
</div>
