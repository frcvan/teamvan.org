---
import UpdateCard from "@/components/UpdateCard.astro";
import { updates } from "@/data/updates";

interface Props {
    title?: string;
    limit?: number;
}

const { title = "Latest from the team", limit = 3 } = Astro.props as Props;
const recent = updates.slice(0, Math.max(limit, 1));
---

{recent.length > 0 && (
    <section class="my-8">
        <header class="updates-header">
            <div class="flex flex-wrap items-baseline justify-between gap-2">
                <h2 class="m-0">{title}</h2>
                <a href="/updates/" class="link-bar font-bold text-link">
                    All updates
                </a>
            </div>
        </header>
        <ul class="mt-4 grid list-none gap-5 p-0">
            {recent.map((post) => (
                <li>
                    <UpdateCard update={post} />
                </li>
            ))}
        </ul>
    </section>
)}

<style>
    /* Match the page-level section headers, which are direct children of main. */
    .updates-header {
        margin-inline: calc(50% - 50vw);
        padding-inline: calc(50vw - 50%);
        padding-block: 0.9rem 1rem;
        border-top: 4px solid var(--gold);
        border-bottom: 3px solid var(--rule);
        background-color: var(--secondary-background);
    }
</style>
