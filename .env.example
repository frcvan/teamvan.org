# GitHub App slug: the last segment of https://github.com/settings/apps/<slug>.
# Inlined at build time, so set it as a build variable. Never put secrets in PUBLIC_ variables.
PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=

# Worker runtime secrets. Set these with `wrangler secret put`.
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
